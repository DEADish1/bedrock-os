#!/bin/sh
set -eu

# Build for both supported x86 CPU vendors, independent of the build host.
printf '%s\n' 'AMD64UCODE_INITRAMFS=early' > /etc/default/amd64-microcode
update-initramfs -u -k all

# Remove host-specific and disposable build state before SquashFS is created.
rm -f \
  /etc/.resolv.conf.systemd-resolved.bak \
  /etc/nvme/hostid \
  /etc/nvme/hostnqn \
  /root/.wget-hsts \
  /run/systemd/resolve/stub-resolv.conf \
  /var/cache/apt/pkgcache.bin \
  /var/cache/apt/srcpkgcache.bin \
  /var/lib/systemd/random-seed
