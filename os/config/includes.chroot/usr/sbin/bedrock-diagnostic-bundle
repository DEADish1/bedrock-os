#!/usr/bin/python3
import hashlib
import io
import json
import os
import pathlib
import re
import stat
import sys
import tarfile
import tempfile
import time

CONSENT = "CREATE REDACTED DIAGNOSTIC BUNDLE"
SENSITIVE_KEY = re.compile(r"(?:address|credential|fingerprint|host(?:name)?|ip|key|mac|pass(?:word)?|path|secret|serial|token)", re.I)
SENSITIVE_VALUE = [
    re.compile(r"\b(?:[0-9a-f]{2}:){5}[0-9a-f]{2}\b", re.I),
    re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b"),
    re.compile(r"\b[0-9a-f]{64}\b", re.I),
]
SOURCES = {
    "release": ("etc/bedrock-release", "text"),
    "hardware": ("var/lib/bedrock/hardware/inventory.json", "json"),
    "storage-health": ("var/lib/bedrock/storage/health.json", "json"),
    "storage-alerts": ("var/lib/bedrock/storage/alerts.json", "json"),
    "virtual-machines": ("var/lib/bedrock/virtualization/status.json", "json"),
    "updates": ("var/lib/bedrock/update/last-check.json", "json"),
}

def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")

def redact(value, key: str = ""):
    if SENSITIVE_KEY.search(key):
        return "[redacted]"
    if isinstance(value, dict):
        return {name: redact(item, name) for name, item in value.items()}
    if isinstance(value, list):
        return [redact(item, key) for item in value[:512]]
    if isinstance(value, str):
        result = value[:4096]
        for pattern in SENSITIVE_VALUE:
            result = pattern.sub("[redacted]", result)
        return result
    return value

def read_regular(path: pathlib.Path) -> bytes:
    info = path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_size > 1048576:
        raise ValueError("unsafe source")
    return path.read_bytes()

def add_bytes(bundle: tarfile.TarFile, name: str, content: bytes) -> None:
    info = tarfile.TarInfo(name)
    info.size = len(content)
    info.mode = 0o600
    info.mtime = 0
    bundle.addfile(info, io.BytesIO(content))

def main() -> None:
    if len(sys.argv) != 3 or sys.argv[1] != CONSENT:
        fail(f'usage: bedrock-diagnostic-bundle "{CONSENT}" OUTPUT.tar.gz')
    test = os.environ.get("BEDROCK_DIAGNOSTIC_TEST_MODE") == "1"
    if not test and os.geteuid() != 0:
        fail("diagnostic bundle creation requires root")
    root = pathlib.Path(os.environ.get("BEDROCK_DIAGNOSTIC_ROOT", "/")) if test else pathlib.Path("/")
    output = pathlib.Path(sys.argv[2])
    direct_parent = output.parent
    parent = direct_parent.resolve()
    if output.suffixes[-2:] != [".tar", ".gz"] or output.exists() or output.is_symlink() or not direct_parent.is_dir() or direct_parent.is_symlink():
        fail("output must be a new .tar.gz file in a direct directory")
    entries = []
    rendered = {}
    for name, (relative, kind) in SOURCES.items():
        source = root / relative
        try:
            raw = read_regular(source)
            if kind == "json":
                value = json.loads(raw.decode("utf-8"))
                content = (json.dumps(redact(value), sort_keys=True, separators=(",", ":")) + "\n").encode()
                target = f"diagnostics/{name}.json"
            else:
                content = redact(raw.decode("utf-8", "replace")).encode()
                target = f"diagnostics/{name}.txt"
            rendered[target] = content
            entries.append({"name": name, "status": "included", "sha256": hashlib.sha256(content).hexdigest()})
        except (OSError, ValueError, UnicodeError, json.JSONDecodeError):
            entries.append({"name": name, "status": "unavailable"})
    manifest = {"schema": 1, "created_unix": int(os.environ.get("BEDROCK_DIAGNOSTIC_TEST_NOW", str(int(time.time())))), "redacted": True, "sources": entries}
    handle, temporary = tempfile.mkstemp(prefix=".bedrock-diagnostics.", suffix=".tar.gz", dir=parent)
    os.close(handle)
    try:
        with tarfile.open(temporary, "w:gz", format=tarfile.PAX_FORMAT) as bundle:
            add_bytes(bundle, "diagnostics/manifest.json", (json.dumps(manifest, sort_keys=True, separators=(",", ":")) + "\n").encode())
            for name in sorted(rendered):
                add_bytes(bundle, name, rendered[name])
        os.chmod(temporary, 0o600)
        os.replace(temporary, output)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    print(json.dumps({"schema": 1, "status": "completed", "output": str(output), "included": len(rendered)}, sort_keys=True, separators=(",", ":")))

if __name__ == "__main__":
    main()
