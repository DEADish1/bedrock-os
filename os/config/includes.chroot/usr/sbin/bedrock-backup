#!/usr/bin/python3
import hashlib, json, os, pathlib, re, stat, subprocess, sys, tempfile, time
try:
    import fcntl
except ModuleNotFoundError:
    if os.name!="nt": raise
    class fcntl:
        LOCK_EX=0
        @staticmethod
        def flock(_handle,_mode): pass

NAME=re.compile(r"^[a-z][a-z0-9-]{0,31}$")
SNAPSHOT=re.compile(r"^[0-9a-f]{8,64}$")
REMOTE=re.compile(r"^sftp:[a-z_][a-z0-9_-]{0,31}@[A-Za-z0-9.-]{1,253}:/[A-Za-z0-9_./-]{1,512}$")
FIELDS={"id","name","source","repository","kind","schedule","retention","created_unix","last_success_unix","last_snapshot"}

def fail(message): raise SystemExit(f"error: {message}")
def regular(path,limit):
    info=path.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_size>limit: fail("backup state input is unsafe")
    return path.read_text(encoding="utf-8")
def atomic(path,value,mode=0o600):
    path.parent.mkdir(parents=True,exist_ok=True)
    handle,temp=tempfile.mkstemp(prefix=".backup.",dir=path.parent)
    try:
        with os.fdopen(handle,"w",encoding="utf-8") as out: json.dump(value,out,sort_keys=True,separators=(",",":")); out.write("\n"); out.flush(); os.fsync(out.fileno())
        os.chmod(temp,mode); os.replace(temp,path)
    finally:
        if os.path.exists(temp): os.unlink(temp)
def publish(state,test):
    path=pathlib.Path(os.environ.get("BEDROCK_BACKUP_STATUS",str(pathlib.Path(os.environ.get("BEDROCK_BACKUP_STATE_DIR","."))/"status.json"))) if test else pathlib.Path("/var/lib/bedrock/api/sources/backups.json")
    safe={"schema":1,"plans":[{"id":item["id"],"name":item["name"],"kind":item["kind"],"schedule":item["schedule"],"retention":item["retention"],"created_unix":item["created_unix"],"last_success_unix":item["last_success_unix"],"has_snapshot":item["last_snapshot"] is not None} for item in state["plans"]]}
    atomic(path,safe,0o644)
def validate_plan(item):
    if not isinstance(item,dict) or set(item)!=FIELDS or not NAME.fullmatch(item["id"]) or not isinstance(item["name"],str) or not 1<=len(item["name"])<=64: fail("backup plan is invalid")
    if item["kind"] not in {"local","remote"} or not isinstance(item["source"],str) or not isinstance(item["repository"],str): fail("backup plan is invalid")
    schedule=item["schedule"]; retention=item["retention"]
    if not isinstance(schedule,dict) or set(schedule)!={"frequency","hour_utc","weekday"} or schedule["frequency"] not in {"daily","weekly"} or type(schedule["hour_utc"]) is not int or not 0<=schedule["hour_utc"]<=23 or (schedule["frequency"]=="daily" and schedule["weekday"] is not None) or (schedule["frequency"]=="weekly" and (type(schedule["weekday"]) is not int or not 0<=schedule["weekday"]<=6)): fail("backup schedule is invalid")
    if not isinstance(retention,dict) or set(retention)!={"daily","weekly","monthly"} or any(type(retention[key]) is not int or not 0<=retention[key]<=365 for key in retention) or sum(retention.values())<1: fail("backup retention is invalid")
    if type(item["created_unix"]) is not int or item["created_unix"]<0 or (item["last_success_unix"] is not None and (type(item["last_success_unix"]) is not int or item["last_success_unix"]<0)) or (item["last_snapshot"] is not None and not SNAPSHOT.fullmatch(item["last_snapshot"])): fail("backup history is invalid")
def load(path):
    if not path.exists(): return {"schema":1,"plans":[]}
    try: value=json.loads(regular(path,1048576))
    except (OSError,ValueError,json.JSONDecodeError): fail("backup state is invalid")
    if not isinstance(value,dict) or set(value)!={"schema","plans"} or value["schema"]!=1 or not isinstance(value["plans"],list) or len(value["plans"])>64: fail("backup state is invalid")
    for item in value["plans"]: validate_plan(item)
    if len({item["id"] for item in value["plans"]})!=len(value["plans"]): fail("backup state is invalid")
    return value
def confined(path,root,must_exist):
    if not path.is_absolute() or path==root or (must_exist and (not path.is_dir() or path.is_symlink())): fail("backup path is invalid")
    try: path.resolve(strict=must_exist).relative_to(root.resolve(strict=True))
    except (OSError,ValueError): fail("backup path is outside the allowed root")
def context():
    test=os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1"
    if not test and os.geteuid()!=0: fail("backup management requires root")
    base=pathlib.Path(os.environ.get("BEDROCK_BACKUP_STATE_DIR","/var/lib/bedrock/backup")) if test else pathlib.Path("/var/lib/bedrock/backup")
    data=pathlib.Path(os.environ.get("BEDROCK_BACKUP_DATA_ROOT","/srv/bedrock")) if test else pathlib.Path("/srv/bedrock")
    repos=pathlib.Path(os.environ.get("BEDROCK_BACKUP_LOCAL_ROOT","/mnt")) if test else pathlib.Path("/mnt")
    restores=pathlib.Path(os.environ.get("BEDROCK_BACKUP_RESTORE_ROOT",str(data/"restores"))) if test else data/"restores"
    restic=os.environ.get("BEDROCK_BACKUP_RESTIC","restic") if test else "/usr/bin/restic"
    base.mkdir(parents=True,exist_ok=True)
    if not base.is_dir() or base.is_symlink(): fail("backup state directory is unsafe")
    return base,data,repos,restores,restic
def secret(base,plan):
    path=base/"secrets"/(plan+".password")
    try: info=path.lstat(); value=regular(path,4096).strip()
    except OSError: fail("backup password file is unavailable")
    if not value or len(value)<16 or (os.name!="nt" and info.st_mode&0o077): fail("backup password file must be owner-only and at least 16 characters")
    return path
def restic_call(restic,plan,password,*arguments,capture=False):
    env={"PATH":"/usr/sbin:/usr/bin:/sbin:/bin","RESTIC_PASSWORD_FILE":str(password)}
    command=([sys.executable,restic] if os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1" and restic.endswith(".py") else [restic])+["-r",plan["repository"],*arguments]
    env.update({key:value for key,value in os.environ.items() if key.startswith("BEDROCK_TEST_")})
    result=subprocess.run(command,env=env,text=True,capture_output=capture)
    if result.returncode: fail("encrypted backup operation failed")
    return result.stdout if capture else ""
def latest(restic,plan,password):
    try: values=json.loads(restic_call(restic,plan,password,"snapshots","--json","--latest","1",capture=True))
    except (ValueError,json.JSONDecodeError): fail("backup snapshot result is invalid")
    if not isinstance(values,list) or len(values)!=1 or not isinstance(values[0],dict) or not SNAPSHOT.fullmatch(values[0].get("id","")): fail("backup snapshot result is invalid")
    return values[0]["id"]
def validate_paths(plan,data,repos):
    source=pathlib.Path(plan["source"]); confined(source,data,True)
    if plan["kind"]=="local": confined(pathlib.Path(plan["repository"]),repos,True)
    elif not REMOTE.fullmatch(plan["repository"]): fail("remote repository must use a bounded SFTP destination")
    return source
def run_plan(base,data,repos,restic,state,plan,now):
    source=validate_paths(plan,data,repos); password=secret(base,plan["id"])
    restic_call(restic,plan,password,"backup",str(source),"--one-file-system","--json")
    snapshot=latest(restic,plan,password)
    keep=plan["retention"]; restic_call(restic,plan,password,"forget","--prune","--keep-daily",str(keep["daily"]),"--keep-weekly",str(keep["weekly"]),"--keep-monthly",str(keep["monthly"]))
    plan["last_success_unix"]=now; plan["last_snapshot"]=snapshot; atomic(base/"plans.json",state)
    return snapshot
def main():
    if len(sys.argv)<2 or sys.argv[1] not in {"create","list","run","run-due","restore","restore-latest"}: fail("usage: bedrock-backup create|list|run|run-due|restore|restore-latest ...")
    if os.environ.get("BEDROCK_BACKUP_TEST_MODE")!="1" and sys.argv[1]!="list" and subprocess.run(["/usr/lib/bedrock/require-normal-mode"]).returncode: fail("maintenance mode blocks backup mutation")
    base,data,repos,restores,restic=context(); state_path=base/"plans.json"; lock_path=base/".lock"; now=int(os.environ.get("BEDROCK_BACKUP_TEST_NOW",str(int(time.time()))))
    with lock_path.open("a+") as lock:
        os.chmod(lock_path,0o600); fcntl.flock(lock,fcntl.LOCK_EX); state=load(state_path); command=sys.argv[1]; publish(state,os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1")
        if command=="list":
            if len(sys.argv)!=2: fail("list accepts no arguments")
            print(json.dumps(state,sort_keys=True,separators=(",",":"))); return
        if command=="create":
            if len(sys.argv)!=4: fail("create requires REQUEST.json and its exact confirmation")
            request_path=pathlib.Path(sys.argv[2])
            try: request=json.loads(regular(request_path,65536))
            except (OSError,ValueError,json.JSONDecodeError): fail("backup request is invalid")
            fields={"id","name","source","repository","kind","schedule","retention","initialize"}
            if not isinstance(request,dict) or set(request)!=fields or type(request["initialize"]) is not bool: fail("backup request is invalid")
            canonical=json.dumps(request,sort_keys=True,separators=(",",":")); digest=hashlib.sha256(canonical.encode()).hexdigest()
            if sys.argv[3]!=f"CREATE ENCRYPTED BACKUP {request.get('id','')} {digest}": fail("backup confirmation is invalid")
            plan={key:request[key] for key in fields-{"initialize"}}|{"created_unix":now,"last_success_unix":None,"last_snapshot":None}; validate_plan(plan)
            if any(item["id"]==plan["id"] for item in state["plans"]): fail("backup plan already exists")
            source=pathlib.Path(plan["source"]); confined(source,data,True); password=secret(base,plan["id"])
            if plan["kind"]=="local": confined(pathlib.Path(plan["repository"]),repos,not request["initialize"])
            elif not REMOTE.fullmatch(plan["repository"]): fail("remote repository must use a bounded SFTP destination")
            restic_call(restic,plan,password,"init" if request["initialize"] else "snapshots")
            state["plans"].append(plan); atomic(state_path,state); publish(state,os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1"); print(json.dumps({"schema":1,"status":"created","plan":plan["id"]},sort_keys=True,separators=(",",":"))); return
        if command=="run-due":
            if len(sys.argv)!=2: fail("run-due accepts no arguments")
            ran=[]; tm=time.gmtime(now)
            for plan in state["plans"]:
                interval=86400 if plan["schedule"]["frequency"]=="daily" else 604800
                weekday_ok=plan["schedule"]["weekday"] is None or plan["schedule"]["weekday"]==tm.tm_wday
                if tm.tm_hour==plan["schedule"]["hour_utc"] and weekday_ok and (plan["last_success_unix"] is None or now-plan["last_success_unix"]>=interval-3600): run_plan(base,data,repos,restic,state,plan,now); ran.append(plan["id"])
            publish(state,os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1"); print(json.dumps({"schema":1,"status":"completed","ran":ran},sort_keys=True,separators=(",",":"))); return
        if len(sys.argv)<3 or not NAME.fullmatch(sys.argv[2]): fail("backup plan identity is invalid")
        matches=[item for item in state["plans"] if item["id"]==sys.argv[2]]
        if len(matches)!=1: fail("backup plan is unavailable")
        plan=matches[0]
        if command=="run":
            if len(sys.argv)!=4 or sys.argv[3]!=f"RUN ENCRYPTED BACKUP {plan['id']}": fail("backup run confirmation is invalid")
            snapshot=run_plan(base,data,repos,restic,state,plan,now); publish(state,os.environ.get("BEDROCK_BACKUP_TEST_MODE")=="1"); print(json.dumps({"schema":1,"status":"completed","snapshot":snapshot},sort_keys=True,separators=(",",":"))); return
        if command=="restore-latest":
            if len(sys.argv)!=4 or sys.argv[3]!=f"RESTORE LATEST BACKUP {plan['id']}" or plan["last_snapshot"] is None: fail("restore latest confirmation or history is invalid")
            snapshot=plan["last_snapshot"]
        else:
            if len(sys.argv)!=5 or not SNAPSHOT.fullmatch(sys.argv[3]) or sys.argv[4]!=f"RESTORE BACKUP {plan['id']} SNAPSHOT {sys.argv[3]}": fail("restore confirmation is invalid")
            snapshot=sys.argv[3]
        validate_paths(plan,data,repos); target=restores/plan["id"]
        if target.exists() or target.is_symlink(): fail("restore target already exists")
        restores.mkdir(parents=True,exist_ok=True); confined(restores,data,True); password=secret(base,plan["id"])
        restic_call(restic,plan,password,"restore",snapshot,"--target",str(target)); print(json.dumps({"schema":1,"status":"restored","target":str(target),"snapshot":snapshot},sort_keys=True,separators=(",",":")))
if __name__=="__main__": main()
