#!/bin/sh
set -eu

[ "$(id -u)" -eq 0 ] || { printf 'error: bedrock-update must run as root\n' >&2; exit 1; }
[ "$#" -eq 1 ] || { printf 'usage: %s BUNDLE_DIR\n' "$0" >&2; exit 2; }
bundle=$1
cert=${BEDROCK_UPDATE_CERT:-/usr/share/bedrock/update-trust.pem}
verifier=${BEDROCK_VERIFY_UPDATE:-/usr/lib/bedrock/verify-update-bundle}
"$verifier" "$bundle" "$cert"

current=${BEDROCK_CURRENT_SLOT:-}
if [ -n "$current" ] && [ "${BEDROCK_TEST_MODE:-0}" != 1 ]; then printf 'error: slot override is test-only\n' >&2; exit 1; fi
if [ -z "$current" ]; then for argument in $(cat /proc/cmdline); do case "$argument" in bedrock.slot=a) current=a ;; bedrock.slot=b) current=b ;; esac; done; fi
[ -n "$current" ] || { printf 'error: running slot is unknown\n' >&2; exit 1; }
if [ "$current" = a ]; then target=b; root_label=bedrock-root-b; verity_label=bedrock-verity-b; signature_label=bedrock-verity-sig-b; else target=a; root_label=bedrock-root-a; verity_label=bedrock-verity-a; signature_label=bedrock-verity-sig-a; fi

manifest="$bundle/manifest.json"
generation=$(jq -r .generation "$manifest")
state_dir=${BEDROCK_UPDATE_STATE_DIR:-/var/lib/bedrock/update}
installed=0
[ ! -s "$state_dir/generation" ] || installed=$(cat "$state_dir/generation")
printf '%s' "$installed" | grep -Eq '^[0-9]+$' || { printf 'error: installed generation state is invalid\n' >&2; exit 1; }
[ "$generation" -gt "$installed" ] || { printf 'error: update generation is not newer than the installed generation\n' >&2; exit 1; }

device_root=${BEDROCK_DEVICE_ROOT:-/dev/disk/by-partlabel}
disk_image=${BEDROCK_DISK_IMAGE:-}
[ -z "$disk_image" ] || [ "${BEDROCK_TEST_MODE:-0}" = 1 ] || { printf 'error: disk-image target is test-only\n' >&2; exit 1; }
root_device="$device_root/$root_label"
verity_device="$device_root/$verity_label"
signature_device="$device_root/$signature_label"
esp_device="$device_root/bedrock-esp"
if [ -z "$disk_image" ]; then
  for device in "$root_device" "$verity_device" "$signature_device" "$esp_device"; do [ -b "$device" ] || { printf 'error: required update target is unavailable: %s\n' "$device" >&2; exit 1; }; done
  findmnt --source "$root_device" >/dev/null 2>&1 && { printf 'error: inactive root target is mounted\n' >&2; exit 1; }
fi

write_artifact() {
  source=$1
  device=$2
  size=$(stat -c %s "$source")
  [ "$size" -le "$(blockdev --getsize64 "$device")" ] || { printf 'error: artifact exceeds target partition\n' >&2; exit 1; }
  dd if="$source" of="$device" bs=4M conv=fsync,notrunc status=none
  expected=$(sha256sum "$source" | awk '{print $1}')
  actual=$(dd if="$device" bs=1M count=$(( (size + 1048575) / 1048576 )) status=none | head -c "$size" | sha256sum | awk '{print $1}')
  [ "$actual" = "$expected" ] || { printf 'error: post-write verification failed\n' >&2; exit 1; }
}

write_image_artifact() {
  source=$1
  number=$2
  start=$(sgdisk --info="$number" "$disk_image" | sed -n 's/^First sector: *\([0-9][0-9]*\).*/\1/p')
  sectors=$(sgdisk --info="$number" "$disk_image" | sed -n 's/^Partition size: *\([0-9][0-9]*\).*/\1/p')
  size=$(stat -c %s "$source")
  [ "$size" -le "$((sectors * 512))" ] || { printf 'error: artifact exceeds image partition\n' >&2; exit 1; }
  dd if="$source" of="$disk_image" bs=512 seek="$start" conv=fsync,notrunc status=none
  expected=$(sha256sum "$source" | awk '{print $1}')
  actual=$(dd if="$disk_image" bs=512 skip="$start" count=$(( (size + 511) / 512 )) status=none | head -c "$size" | sha256sum | awk '{print $1}')
  [ "$actual" = "$expected" ] || { printf 'error: image post-write verification failed\n' >&2; exit 1; }
}

if [ -n "$disk_image" ]; then
  if [ "$target" = b ]; then root_number=5; verity_number=6; signature_number=7; else root_number=2; verity_number=3; signature_number=4; fi
  write_image_artifact "$bundle/root.erofs" "$root_number"
  write_image_artifact "$bundle/root.verity" "$verity_number"
  write_image_artifact "$bundle/verity-sig.json" "$signature_number"
else
  write_artifact "$bundle/root.erofs" "$root_device"
  write_artifact "$bundle/root.verity" "$verity_device"
  write_artifact "$bundle/verity-sig.json" "$signature_device"
fi

if [ -n "$disk_image" ]; then
  esp_offset=$(( $(sgdisk --info=1 "$disk_image" | sed -n 's/^First sector: *\([0-9][0-9]*\).*/\1/p') * 512 ))
  mdel -i "$disk_image@@$esp_offset" "::/EFI/Linux/bedrock-$target*.efi" 2>/dev/null || true
  mcopy -i "$disk_image@@$esp_offset" "$bundle/uki.efi" "::/EFI/Linux/bedrock-$target+3.efi"
else
  esp=${BEDROCK_UPDATE_ESP_MOUNT:-/run/bedrock-update-esp}
  mkdir -p "$esp"
  mount "$esp_device" "$esp"
  cleanup() { mountpoint -q "$esp" && umount "$esp" || true; }
  trap cleanup EXIT INT TERM
  efi_dir="$esp/EFI/Linux"
  mkdir -p "$efi_dir"
  find "$efi_dir" -maxdepth 1 -type f -name "bedrock-$target*.efi" -delete
  cp "$bundle/uki.efi" "$efi_dir/bedrock-$target+3.efi"
  sync
fi

mkdir -p "$state_dir"
temporary="$state_dir/pending.json.tmp"
jq -n --arg slot "$target" --arg version "$(jq -r .version "$manifest")" --argjson generation "$generation" \
  '{schema:1,slot:$slot,version:$version,generation:$generation}' > "$temporary"
mv "$temporary" "$state_dir/pending.json"
printf 'Installed Bedrock generation %s into inactive slot %s; reboot to validate it.\n' "$generation" "$target"
