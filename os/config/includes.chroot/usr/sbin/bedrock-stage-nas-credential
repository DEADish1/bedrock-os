#!/bin/sh
set -eu

[ ! -x /usr/lib/bedrock/require-normal-mode ] || /usr/lib/bedrock/require-normal-mode
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
[ "$#" -eq 3 ] || fail "usage: bedrock-stage-nas-credential USER PASSWORD_FILE CONFIRMATION"
user=$1 source=$2 confirmation=$3
printf '%s' "$user" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$' || fail "NAS user is invalid"
[ "$confirmation" = "STAGE NAS CREDENTIAL — $user" ] || fail "exact confirmation is required"
if [ "${BEDROCK_NAS_CREDENTIAL_TEST_MODE:-0}" = 1 ]; then
  state=${BEDROCK_NAS_CREDENTIAL_STATE:?test mode requires state}
  base=${BEDROCK_NAS_CREDENTIAL_BASE:?test mode requires base}
else
  [ "$(id -u)" -eq 0 ] || fail "staging a NAS credential requires root"
  state=/var/lib/bedrock/storage/nas.json
  base=/var/lib/bedrock/storage/credential-secrets
fi
[ -s "$state" ] && [ ! -L "$state" ] || fail "NAS state is missing or indirect"
[ -f "$source" ] && [ ! -L "$source" ] && [ -s "$source" ] || fail "password file is missing, empty, or indirect"
[ "$(wc -c < "$source" | tr -d ' ')" -le 1024 ] || fail "password file is too large"
[ "$(wc -l < "$source" | tr -d ' ')" -eq 1 ] || fail "password must be one line"
[ "$(wc -c < "$source" | tr -d ' ')" -ge 13 ] || fail "password must contain at least twelve characters"
directory=$(dirname -- "$state"); lock=$directory/.nas-operation.lock
mkdir "$lock" 2>/dev/null || fail "another NAS operation is already running"
secret_tmp=; state_tmp=
cleanup() { [ -z "$secret_tmp" ] || rm -f "$secret_tmp"; [ -z "$state_tmp" ] || rm -f "$state_tmp"; rmdir "$lock" 2>/dev/null || true; }
trap cleanup EXIT INT TERM
[ -s "$state" ] && [ ! -L "$state" ] || fail "NAS state changed or became indirect"
jq -e --arg user "$user" '.schema==1 and ([.users[]|select(.name==$user)]|length)==1' "$state" >/dev/null || fail "managed NAS user is unavailable"
mkdir -p "$base"; chmod 0700 "$base"
secret="$base/$user.password"; [ ! -e "$secret" ] && [ ! -L "$secret" ] || fail "a credential is already staged for this user"
secret_tmp=$(mktemp "$base/.credential.XXXXXX"); state_tmp=$(mktemp "$directory/.nas.XXXXXX")
chmod 0600 "$secret_tmp"; cp "$source" "$secret_tmp"
jq -S --arg user "$user" '.users |= map(if .name==$user then .credential_candidate=true else . end)' "$state" > "$state_tmp"
chmod 0600 "$state_tmp"; mv "$secret_tmp" "$secret"; secret_tmp=
if ! mv "$state_tmp" "$state"; then rm -f "$secret"; fail "credential candidate state could not be committed"; fi
state_tmp=
trap - EXIT INT TERM; rmdir "$lock"
printf '{"schema":1,"status":"staged","user":"%s","secret_recorded":false}\n' "$user"
