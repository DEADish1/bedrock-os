{
  "openapi": "3.1.0",
  "info": {
    "title": "Bedrock local management API",
    "version": "1.0.0"
  },
  "servers": [{"url": "http://localhost"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/api/v1/openapi.json": {"get": {"operationId": "getApiSchema", "responses": {"200": {"description": "Version 1 OpenAPI schema"}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/health": {"get": {"operationId": "getHealth", "responses": {"200": {"description": "API health", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/hardware": {"get": {"operationId": "getHardware", "responses": {"200": {"description": "Privacy-safe hardware inventory", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Hardware"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/images": {"get": {"operationId": "getImages", "responses": {"200": {"description": "Path-free verified image inventory", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ImageFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/dashboard": {"get": {"operationId": "getDashboard", "responses": {"200": {"description": "Privacy-safe dashboard summary", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Dashboard"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}}}},
    "/api/v1/tasks": {"get": {"operationId": "getTasks", "responses": {"200": {"description": "Bounded tasks and progress", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TaskFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/alerts": {"get": {"operationId": "getAlerts", "responses": {"200": {"description": "Privacy-safe active alerts", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AlertFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/audit": {"get": {"operationId": "getAudit", "responses": {"200": {"description": "Bounded audit history", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AuditFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/apps": {"get": {"operationId": "getApps", "responses": {"200": {"description": "Privacy-safe isolated application status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AppFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/backups": {"get": {"operationId": "getBackups", "responses": {"200": {"description": "Privacy-safe encrypted backup plan status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/BackupFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/remote/devices": {"get": {"operationId": "getRemoteDevices", "responses": {"200": {"description": "Privacy-safe paired-device status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RemoteDeviceFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/virtualization/capabilities": {"get": {"operationId": "getVirtualizationCapabilities", "responses": {"200": {"description": "Virtualization capability report"}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}},
    "/api/v1/vms": {"get": {"operationId": "getVirtualMachines", "responses": {"200": {"description": "Managed virtual machine status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VmFeed"}}}}, "401": {"$ref": "#/components/responses/Unauthorized"}, "503": {"$ref": "#/components/responses/Unavailable"}}}}
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque-256-bit"}},
    "responses": {
      "Unauthorized": {"description": "Missing, malformed, unknown, or revoked bearer token"},
      "Unavailable": {"description": "The independently validated state source is unavailable"}
    },
    "schemas": {
      "Health": {"type": "object", "additionalProperties": false, "required": ["schema", "status", "api_version"], "properties": {"schema": {"const": 1}, "status": {"const": "ok"}, "api_version": {"const": "v1"}}},
      "HardwareCpu": {"type": "object", "additionalProperties": false, "required": ["architecture", "model", "logical_processors", "sockets", "cores_per_socket", "threads_per_core", "virtualization", "virtualization_supported"], "properties": {"architecture": {"type": "string", "maxLength": 32}, "model": {"type": "string", "maxLength": 160}, "logical_processors": {"type": "integer", "minimum": 1}, "sockets": {"type": "integer", "minimum": 1}, "cores_per_socket": {"type": "integer", "minimum": 1}, "threads_per_core": {"type": "integer", "minimum": 1}, "virtualization": {"type": "string", "maxLength": 32}, "virtualization_supported": {"type": "boolean"}}},
      "HardwareDisk": {"type": "object", "additionalProperties": false, "required": ["model", "vendor", "size_bytes", "rotational", "transport", "removable"], "properties": {"model": {"type": "string", "maxLength": 160}, "vendor": {"type": "string", "maxLength": 80}, "size_bytes": {"type": "integer", "minimum": 0}, "rotational": {"type": "boolean"}, "transport": {"type": "string", "maxLength": 32}, "removable": {"type": "boolean"}}},
      "HardwareController": {"type": "object", "additionalProperties": false, "required": ["class", "description"], "properties": {"class": {"type": "string", "maxLength": 32}, "description": {"type": "string", "maxLength": 240}}},
      "HardwareNetwork": {"type": "object", "additionalProperties": false, "required": ["mtu", "state", "link_type"], "properties": {"mtu": {"type": "integer", "minimum": 576}, "state": {"type": "string", "maxLength": 32}, "link_type": {"type": "string", "maxLength": 32}}},
      "HardwareGpu": {"type": "object", "additionalProperties": false, "required": ["vendor", "driver", "boot_vga", "recognized_vendor"], "properties": {"vendor": {"type": "string", "maxLength": 32}, "driver": {"type": "string", "maxLength": 64}, "boot_vga": {"type": "boolean"}, "recognized_vendor": {"type": "boolean"}}},
      "Hardware": {"type": "object", "additionalProperties": false, "required": ["schema", "cpu", "memory", "disks", "storage_controllers", "networks", "gpus", "usb_device_count"], "properties": {"schema": {"const": 1}, "cpu": {"$ref": "#/components/schemas/HardwareCpu"}, "memory": {"type": "object", "additionalProperties": false, "required": ["total_bytes"], "properties": {"total_bytes": {"type": "integer", "minimum": 1}}}, "disks": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HardwareDisk"}}, "storage_controllers": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HardwareController"}}, "networks": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HardwareNetwork"}}, "gpus": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/HardwareGpu"}}, "usb_device_count": {"type": "integer", "minimum": 0, "maximum": 256}}},
      "Image": {"type": "object", "additionalProperties": false, "required": ["name", "type", "sha256", "size_bytes", "converted"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "type": {"enum": ["iso", "img", "qcow2", "vhdx", "vmdk"]}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 4398046511104}, "converted": {"type": "boolean"}}},
      "ImageFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "images"], "properties": {"schema": {"const": 1}, "images": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/Image"}}}},
      "Dashboard": {"type": "object", "additionalProperties": false, "required": ["schema", "components", "partial"], "properties": {"schema": {"const": 1}, "components": {"type": "object"}, "partial": {"type": "boolean"}}},
      "Progress": {"type": "object", "additionalProperties": false, "required": ["current", "total", "unit"], "properties": {"current": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1}, "unit": {"enum": ["bytes", "items", "percent", "steps"]}}},
      "Task": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "state", "created_unix", "updated_unix", "progress"], "properties": {"id": {"type": "string", "maxLength": 64}, "kind": {"type": "string", "maxLength": 64}, "state": {"enum": ["queued", "running", "succeeded", "failed", "cancelled"]}, "created_unix": {"type": "integer", "minimum": 0}, "updated_unix": {"type": "integer", "minimum": 0}, "progress": {"$ref": "#/components/schemas/Progress"}}},
      "TaskFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "generated_unix", "tasks"], "properties": {"schema": {"const": 1}, "generated_unix": {"type": "integer", "minimum": 0}, "tasks": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/Task"}}}},
      "Alert": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "severity", "first_seen_unix", "last_seen_unix"], "properties": {"id": {"type": "string", "maxLength": 128}, "kind": {"type": "string", "maxLength": 64}, "severity": {"enum": ["warning", "critical"]}, "first_seen_unix": {"type": "integer", "minimum": 0}, "last_seen_unix": {"type": "integer", "minimum": 0}}},
      "AlertFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "generated_unix", "attention_required", "alerts"], "properties": {"schema": {"const": 1}, "generated_unix": {"type": "integer", "minimum": 0}, "attention_required": {"type": "boolean"}, "alerts": {"type": "array", "maxItems": 256, "items": {"$ref": "#/components/schemas/Alert"}}}},
      "AuditEvent": {"type": "object", "additionalProperties": false, "required": ["id", "category", "action", "outcome", "occurred_unix"], "properties": {"id": {"type": "string", "maxLength": 128}, "category": {"type": "string", "maxLength": 64}, "action": {"type": "string", "maxLength": 64}, "outcome": {"enum": ["succeeded", "failed", "denied"]}, "occurred_unix": {"type": "integer", "minimum": 0}}},
      "AuditFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "events"], "properties": {"schema": {"const": 1}, "events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/components/schemas/AuditEvent"}}}},
      "AppResources": {"type": "object", "additionalProperties": false, "required": ["cpus", "memory_mib", "pids"], "properties": {"cpus": {"type": "number", "minimum": 0.25, "maximum": 16}, "memory_mib": {"type": "integer", "minimum": 128, "maximum": 32768}, "pids": {"type": "integer", "minimum": 16, "maximum": 4096}}},
      "App": {"type": "object", "additionalProperties": false, "required": ["id", "name", "network", "port_count", "resources", "update_policy", "created_unix"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 64}, "network": {"enum": ["none", "bridge"]}, "port_count": {"type": "integer", "minimum": 0, "maximum": 16}, "resources": {"$ref": "#/components/schemas/AppResources"}, "update_policy": {"enum": ["manual", "notify"]}, "created_unix": {"type": "integer", "minimum": 0}}},
      "AppFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "apps"], "properties": {"schema": {"const": 1}, "apps": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/App"}}}},
      "BackupSchedule": {"type": "object", "additionalProperties": false, "required": ["frequency", "hour_utc", "weekday"], "properties": {"frequency": {"enum": ["daily", "weekly"]}, "hour_utc": {"type": "integer", "minimum": 0, "maximum": 23}, "weekday": {"type": ["integer", "null"], "minimum": 0, "maximum": 6}}},
      "BackupRetention": {"type": "object", "additionalProperties": false, "required": ["daily", "weekly", "monthly"], "properties": {"daily": {"type": "integer", "minimum": 0, "maximum": 365}, "weekly": {"type": "integer", "minimum": 0, "maximum": 365}, "monthly": {"type": "integer", "minimum": 0, "maximum": 365}}},
      "BackupPlan": {"type": "object", "additionalProperties": false, "required": ["id", "name", "kind", "schedule", "retention", "created_unix", "last_success_unix", "has_snapshot"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "name": {"type": "string", "minLength": 1, "maxLength": 64}, "kind": {"enum": ["local", "remote"]}, "schedule": {"$ref": "#/components/schemas/BackupSchedule"}, "retention": {"$ref": "#/components/schemas/BackupRetention"}, "created_unix": {"type": "integer", "minimum": 0}, "last_success_unix": {"type": ["integer", "null"], "minimum": 0}, "has_snapshot": {"type": "boolean"}}},
      "BackupFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "plans"], "properties": {"schema": {"const": 1}, "plans": {"type": "array", "maxItems": 64, "items": {"$ref": "#/components/schemas/BackupPlan"}}}},
      "RemoteDevice": {"type": "object", "additionalProperties": false, "required": ["id", "name", "created_unix", "expires_unix", "revoked", "expired", "last_seen_unix"], "properties": {"id": {"type": "string", "format": "uuid"}, "name": {"type": "string", "minLength": 1, "maxLength": 64}, "created_unix": {"type": "integer", "minimum": 0}, "expires_unix": {"type": "integer", "minimum": 1}, "revoked": {"type": "boolean"}, "expired": {"type": "boolean"}, "last_seen_unix": {"type": ["integer", "null"], "minimum": 0}}},
      "RemoteDeviceFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "devices"], "properties": {"schema": {"const": 1}, "devices": {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/RemoteDevice"}}}},
      "Vm": {"type": "object", "additionalProperties": false, "required": ["name", "state", "autostart", "vcpus", "memory_mib", "snapshot_count", "image_attachments", "network_attachments"], "properties": {"name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}, "state": {"enum": ["running", "paused", "shut off", "crashed", "in shutdown", "pmsuspended"]}, "autostart": {"type": "boolean"}, "vcpus": {"type": "integer", "minimum": 1, "maximum": 256}, "memory_mib": {"type": "integer", "minimum": 128, "maximum": 1048576}, "snapshot_count": {"type": "integer", "minimum": 0, "maximum": 4096}, "image_attachments": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}}, "network_attachments": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}}}},
      "VmFeed": {"type": "object", "additionalProperties": false, "required": ["schema", "generated_unix", "domains"], "properties": {"schema": {"const": 1}, "generated_unix": {"type": "integer", "minimum": 0}, "domains": {"type": "array", "maxItems": 128, "items": {"$ref": "#/components/schemas/Vm"}}}}
    }
  }
}
