#!/usr/bin/python3
import hashlib
import json
import os
import pathlib
import pwd
import re
import socket
import stat
import struct
import subprocess
import tempfile
import time
import uuid

MAX_REQUEST_BYTES = 16 * 1024
MAX_RESULTS = 256


class RequestError(Exception):
    def __init__(self, code, message):
        super().__init__(message)
        self.code = code
        self.message = message


def environment():
    test_mode = os.environ.get("BEDROCK_ACTION_BROKER_TEST_MODE") == "1"
    return {
        "test_mode": test_mode,
        "socket": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_SOCKET", "/run/bedrock-action-broker/action.sock")),
        "state": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_STATE", "/var/lib/bedrock/api/action-results.json")),
        "update_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_UPDATE_HELPER", "/usr/sbin/bedrock-update-settings")),
        "vm_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_VM_HELPER", "/usr/lib/bedrock/control-vm")),
        "snapshot_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_SNAPSHOT_HELPER", "/usr/lib/bedrock/manage-vm-snapshot")),
        "clone_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_CLONE_HELPER", "/usr/lib/bedrock/clone-vm")),
        "delete_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_DELETE_HELPER", "/usr/lib/bedrock/delete-vm")),
        "resource_helper": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_RESOURCE_HELPER", "/usr/lib/bedrock/update-vm-resources")),
        "vm_requests": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_VM_REQUESTS", "/var/lib/bedrock/virtualization/requests")),
        "vm_definitions": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_VM_DEFINITIONS", "/var/lib/bedrock/virtualization/definitions")),
        "task_writer": pathlib.Path(os.environ.get("BEDROCK_ACTION_BROKER_TASK_WRITER", "/usr/lib/bedrock/record-api-task")),
        "expected_uid": int(os.environ["BEDROCK_ACTION_BROKER_EXPECTED_UID"]) if test_mode else pwd.getpwnam("bedrock-api").pw_uid,
    }


def response(request_id, status, **extra):
    value = {"schema": 1, "request_id": request_id, "status": status}
    value.update(extra)
    return value


def parse_request(raw):
    try:
        request = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise RequestError("invalid-json", "request must be one UTF-8 JSON object")
    if not isinstance(request, dict) or request.get("schema") != 1:
        raise RequestError("invalid-request", "request fields do not match an action schema")
    request_id = request.get("request_id")
    try:
        parsed_id = uuid.UUID(request_id)
    except (AttributeError, TypeError, ValueError):
        raise RequestError("invalid-request-id", "request_id must be a canonical UUID v4")
    if parsed_id.version != 4 or str(parsed_id) != request_id:
        raise RequestError("invalid-request-id", "request_id must be a canonical UUID v4")
    if request.get("action") == "update-policy":
        if set(request) != {"schema", "request_id", "action", "setting", "value", "beta_risk_acknowledged"} or type(request["beta_risk_acknowledged"]) is not bool:
            raise RequestError("invalid-request", "request fields do not match the update-policy schema")
        setting, value, acknowledged = request["setting"], request["value"], request["beta_risk_acknowledged"]
        if setting == "automatic_checks" and type(value) is bool and not acknowledged:
            details = ["automatic-checks", "on" if value else "off"]
        elif setting == "channel" and value == "stable" and not acknowledged:
            details = ["channel", "stable"]
        elif setting == "channel" and value == "beta" and acknowledged:
            details = ["channel", "beta", "I_ACCEPT_PRERELEASE_UPDATE_RISK"]
        else:
            raise RequestError("invalid-update-policy", "setting, value, and beta acknowledgement are inconsistent")
    elif request.get("action") == "vm-control":
        if set(request) != {"schema", "request_id", "action", "name", "operation", "confirmation"}:
            raise RequestError("invalid-request", "request fields do not match the vm-control schema")
        name, operation, confirmation = request["name"], request["operation"], request["confirmation"]
        if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or operation not in {"start", "stop", "restart", "force-stop"}:
            raise RequestError("invalid-vm-control", "VM name or operation is invalid")
        expected = {"start": "START VM ", "stop": "STOP VM ", "restart": "RESTART VM ", "force-stop": "FORCE STOP VM "}[operation] + name
        if confirmation != expected:
            raise RequestError("invalid-vm-control", "exact VM confirmation is required")
        details = {"schema": 1, "name": name, "action": operation, "confirmation": confirmation}
    elif request.get("action") == "vm-snapshot":
        if set(request) != {"schema", "request_id", "action", "name", "snapshot", "operation", "confirmation"}:
            raise RequestError("invalid-request", "request fields do not match the vm-snapshot schema")
        name, snapshot, operation, confirmation = request["name"], request["snapshot"], request["operation"], request["confirmation"]
        valid_name = lambda value: isinstance(value, str) and re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", value)
        if not valid_name(name) or not valid_name(snapshot) or operation not in {"create", "restore", "delete"}:
            raise RequestError("invalid-vm-snapshot", "VM, snapshot, or operation is invalid")
        expected = {"create": "CREATE SNAPSHOT ", "restore": "RESTORE SNAPSHOT ", "delete": "DELETE SNAPSHOT "}[operation] + snapshot + " FOR VM " + name
        if confirmation != expected:
            raise RequestError("invalid-vm-snapshot", "exact snapshot confirmation is required")
        details = {"schema": 1, "name": name, "snapshot": snapshot, "action": operation, "confirmation": confirmation}
    elif request.get("action") == "vm-clone":
        if set(request) != {"schema", "request_id", "action", "source", "name", "confirmation"}:
            raise RequestError("invalid-request", "request fields do not match the vm-clone schema")
        source, name, confirmation = request["source"], request["name"], request["confirmation"]
        valid_name = lambda value: isinstance(value, str) and re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", value)
        if not valid_name(source) or not valid_name(name) or source == name or confirmation != f"CLONE VM {source} AS {name}":
            raise RequestError("invalid-vm-clone", "VM names or exact clone confirmation are invalid")
        details = {"schema": 1, "source": source, "name": name, "confirmation": confirmation}
    elif request.get("action") == "vm-delete":
        if set(request) != {"schema", "request_id", "action", "name", "confirmation"}:
            raise RequestError("invalid-request", "request fields do not match the vm-delete schema")
        name, confirmation = request["name"], request["confirmation"]
        if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or confirmation != f"DELETE VM {name} AND STORAGE":
            raise RequestError("invalid-vm-delete", "VM name or exact deletion confirmation is invalid")
        details = {"schema": 1, "action": "delete", "name": name, "confirmation": confirmation}
    elif request.get("action") == "vm-resources":
        if set(request) != {"schema", "request_id", "action", "name", "vcpus", "memory_mib", "boot_order", "confirmation"}:
            raise RequestError("invalid-request", "request fields do not match the vm-resources schema")
        name, vcpus, memory, boot, confirmation = request["name"], request["vcpus"], request["memory_mib"], request["boot_order"], request["confirmation"]
        valid_name = isinstance(name, str) and re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name)
        valid_vcpus = type(vcpus) is int and 1 <= vcpus <= 64
        valid_memory = type(memory) is int and 512 <= memory <= 262144 and memory % 256 == 0
        valid_boot = boot in (["disk"], ["cdrom", "disk"])
        expected = f"UPDATE VM {name} CPU {vcpus} MEMORY {memory} BOOT {','.join(boot)}" if valid_name and valid_boot else ""
        if not valid_name or not valid_vcpus or not valid_memory or not valid_boot or confirmation != expected:
            raise RequestError("invalid-vm-resources", "VM resources or exact confirmation are invalid")
        details = {"schema": 1, "name": name, "vcpus": vcpus, "memory_mib": memory, "boot_order": boot, "confirmation": confirmation}
    else:
        raise RequestError("unsupported-action", "action is not allowlisted")
    canonical = json.dumps(request, sort_keys=True, separators=(",", ":")).encode("utf-8")
    return request, hashlib.sha256(canonical).hexdigest(), details


def load_state(path):
    if path.is_symlink():
        raise RuntimeError("action result state is indirect or not a regular file")
    if not path.exists():
        return {"schema": 1, "results": []}
    if not path.is_file():
        raise RuntimeError("action result state is indirect or not a regular file")
    state = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(state, dict) or set(state) != {"schema", "results"} or state["schema"] != 1:
        raise RuntimeError("action result state has an invalid envelope")
    results = state["results"]
    if not isinstance(results, list) or len(results) > MAX_RESULTS:
        raise RuntimeError("action result state has an invalid result list")
    for item in results:
        fields = set(item) if isinstance(item, dict) else set()
        if fields not in ({"request_id", "request_sha256", "action", "status"},
                          {"request_id", "request_sha256", "action", "status", "created_unix"}):
            raise RuntimeError("action result state contains an invalid result")
        if item["action"] not in {"update-policy", "vm-control", "vm-snapshot", "vm-clone", "vm-delete", "vm-resources"} or item["status"] not in {"pending", "succeeded", "failed"}:
            raise RuntimeError("action result state contains an unsupported result")
        if item["status"] != "succeeded" and "created_unix" not in item:
            raise RuntimeError("incomplete action result lacks a creation time")
        if "created_unix" in item and (type(item["created_unix"]) is not int or item["created_unix"] < 0):
            raise RuntimeError("action result has an invalid creation time")
    return state


def save_state(path, state):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o750)
    descriptor, temporary = tempfile.mkstemp(prefix=".action-results.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(state, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def execute_vm(request, request_file, settings, helper_environment):
    request_directory = settings["vm_requests"]
    request_directory.mkdir(parents=True, exist_ok=True, mode=0o750)
    if request_directory.is_symlink() or not request_directory.is_dir():
        raise RuntimeError("VM request directory is unsafe")
    path = request_directory / f"{request['name']}-{request['operation']}.json"
    if path.exists() or path.is_symlink():
        raise RuntimeError("VM request path already exists")
    descriptor, temporary = tempfile.mkstemp(prefix=".vm-control.", dir=request_directory)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(request_file, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        completed = subprocess.run(
            [str(settings["vm_helper"]), str(path)], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=120,
            env=helper_environment, close_fds=True,
        )
        return completed.returncode
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
        if path.exists() and not path.is_symlink():
            path.unlink()


