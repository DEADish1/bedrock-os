def execute_vm_admin(request, request_file, settings, helper_environment):
    request_directory = settings["vm_requests"]
    request_directory.mkdir(parents=True, exist_ok=True, mode=0o750)
    if request_directory.is_symlink() or not request_directory.is_dir():
        raise RuntimeError("VM request directory is unsafe")
    if request["action"] == "vm-clone":
        path = request_directory / f"clone-{request['source']}-as-{request['name']}.json"
        helper = settings["clone_helper"]
    elif request["action"] == "vm-create":
        path = request_directory / f"create-{request['name']}.json"
        helper = settings["create_helper"]
    elif request["action"] == "vm-delete":
        definition = settings["vm_definitions"] / f"{request['name']}.xml"
        descriptor = os.open(definition, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
        try:
            info = os.fstat(descriptor)
            if not stat.S_ISREG(info.st_mode) or info.st_size > 1048576:
                raise RuntimeError("managed VM definition is unsafe")
            with os.fdopen(descriptor, "rb") as stream:
                descriptor = -1
                request_file["definition_sha256"] = hashlib.file_digest(stream, "sha256").hexdigest()
        finally:
            if descriptor >= 0:
                os.close(descriptor)
        path = request_directory / f"{request['name']}-delete.json"
        helper = settings["delete_helper"]
    elif request["action"] == "vm-image-attachment":
        path = request_directory / f"{request['name']}-image-{request['operation']}-{request['image']}.json"
        helper = settings["image_attachment_helper"]
    elif request["action"] == "vm-network-attachment":
        path = request_directory / f"{request['name']}-network-{request['operation']}-{request['network']}.json"
        helper = settings["network_attachment_helper"]
    elif request["action"] == "vm-passthrough":
        path = request_directory / f"{request['name']}-{request['kind']}-{request['operation']}-passthrough.json"
        helper = settings["passthrough_helper"]
    elif request["action"] == "image-convert":
        path = request_directory / f"convert-{request['source']}-to-{request['target']}.json"
        helper = settings["image_conversion_helper"]
    else:
        path = request_directory / f"{request['name']}-resources.json"
        helper = settings["resource_helper"]
    if path.exists() or path.is_symlink():
        raise RuntimeError("VM administration request path already exists")
    descriptor, temporary = tempfile.mkstemp(prefix=".vm-admin.", dir=request_directory)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(request_file, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        completed = subprocess.run(
            [str(helper), str(path)], stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3600,
            env=helper_environment, close_fds=True,
        )
        return completed.returncode
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
        if path.exists() and not path.is_symlink():
            path.unlink()

def execute_remote_device(request, request_file, settings, helper_environment):
