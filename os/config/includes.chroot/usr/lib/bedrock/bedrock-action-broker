def execute(raw, settings):
    request, digest, details = parse_request(raw)
    state = load_state(settings["state"])
    existing = next((item for item in state["results"] if item["request_id"] == request["request_id"]), None)
    if existing:
        if existing["request_sha256"] != digest:
            raise RequestError("idempotency-conflict", "request_id was already used for different input")
        if existing["status"] == "succeeded":
            return response(request["request_id"], "succeeded", replayed=True)
        if existing["status"] == "failed":
            raise RequestError("action-failed", "guarded helper previously rejected the action")
        result_entry = existing
    else:
        result_entry = {"request_id": request["request_id"], "request_sha256": digest,
                        "action": request["action"], "status": "pending", "created_unix": int(time.time())}
        state["results"].append(result_entry)
        state["results"] = state["results"][-MAX_RESULTS:]
        save_state(settings["state"], state)
    helper_environment = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
    if settings["test_mode"]:
        helper_environment["BEDROCK_TEST_CALLS"] = os.environ["BEDROCK_TEST_CALLS"]
        if "BEDROCK_VM_ACTION_CALLS" in os.environ:
            helper_environment["BEDROCK_VM_ACTION_CALLS"] = os.environ["BEDROCK_VM_ACTION_CALLS"]
        if "BEDROCK_SNAPSHOT_ACTION_CALLS" in os.environ:
            helper_environment["BEDROCK_SNAPSHOT_ACTION_CALLS"] = os.environ["BEDROCK_SNAPSHOT_ACTION_CALLS"]
        if "BEDROCK_VM_ADMIN_CALLS" in os.environ:
            helper_environment["BEDROCK_VM_ADMIN_CALLS"] = os.environ["BEDROCK_VM_ADMIN_CALLS"]
        helper_environment["BEDROCK_API_TASK_TEST_MODE"] = "1"
        helper_environment["BEDROCK_API_TASK_STATE_DIR"] = os.environ["BEDROCK_API_TASK_STATE_DIR"]
    if request["action"] == "vm-control":
        completed_code = execute_vm(request, details, settings, helper_environment)
        result_entry["status"] = "succeeded" if completed_code == 0 else "failed"
        save_state(settings["state"], state)
        if completed_code != 0:
            raise RequestError("action-failed", "guarded VM control helper rejected the action")
        return response(request["request_id"], "succeeded", replayed=False)
    if request["action"] == "vm-snapshot":
        completed_code = execute_snapshot(request, details, settings, helper_environment)
        result_entry["status"] = "succeeded" if completed_code == 0 else "failed"
        save_state(settings["state"], state)
        if completed_code != 0:
            raise RequestError("action-failed", "guarded VM snapshot helper rejected the action")
        return response(request["request_id"], "succeeded", replayed=False)
    if request["action"] in {"vm-clone", "vm-delete", "vm-resources", "vm-create", "vm-image-attachment", "vm-network-attachment", "vm-passthrough", "image-convert"}:
        completed_code = execute_vm_admin(request, details, settings, helper_environment)
        result_entry["status"] = "succeeded" if completed_code == 0 else "failed"
        save_state(settings["state"], state)
        if completed_code != 0:
            raise RequestError("action-failed", "guarded VM administration helper rejected the action")
        return response(request["request_id"], "succeeded", replayed=False)
    if request["action"] in {"remote-device", "remote-pairing-approve"}:
        completed_code = execute_remote_device(request, details, settings, helper_environment)
        result_entry["status"] = "succeeded" if completed_code == 0 else "failed"
        save_state(settings["state"], state)
        if completed_code != 0:
            raise RequestError("action-failed", "guarded remote device helper rejected the action")
        return response(request["request_id"], "succeeded", replayed=False)
    if request["action"] in {"backup-run", "backup-restore-latest"}:
        completed_code = execute_backup(request, details, settings, helper_environment)
        result_entry["status"] = "succeeded" if completed_code == 0 else "failed"
        save_state(settings["state"], state)
        if completed_code != 0:
            raise RequestError("action-failed", "guarded backup helper rejected the action")
        return response(request["request_id"], "succeeded", replayed=False)
    task_id = f"settings-{request['request_id']}"
    queued = subprocess.run(
        [str(settings["task_writer"]), task_id, "update-policy", "queued",
         str(result_entry["created_unix"]), "0", "1", "steps"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=10, env=helper_environment, close_fds=True,
    )
    if queued.returncode != 0:
        raise RuntimeError("could not record queued action")
    completed = subprocess.run(
        [str(settings["update_helper"]), *details], stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=30,
        env=helper_environment, close_fds=True,
    )
    if completed.returncode != 0:
        failed = subprocess.run(
            [str(settings["task_writer"]), task_id, "update-policy", "failed",
             str(result_entry["created_unix"]), "0", "1", "steps"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=10, env=helper_environment, close_fds=True,
        )
        if failed.returncode != 0:
            raise RuntimeError("could not record failed action")
        result_entry["status"] = "failed"
        save_state(settings["state"], state)
        raise RequestError("action-failed", "guarded update-policy helper rejected the action")
    succeeded = subprocess.run(
        [str(settings["task_writer"]), task_id, "update-policy", "succeeded",
         str(result_entry["created_unix"]), "1", "1", "steps"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        timeout=10, env=helper_environment, close_fds=True,
    )
    if succeeded.returncode != 0:
        raise RuntimeError("could not record successful action")
    result_entry["status"] = "succeeded"
    save_state(settings["state"], state)
    return response(request["request_id"], "succeeded", replayed=False)


def receive(connection):
    chunks, length = [], 0
    while True:
        chunk = connection.recv(min(4096, MAX_REQUEST_BYTES + 1 - length))
        if not chunk:
            break
        chunks.append(chunk)
        length += len(chunk)
        if length > MAX_REQUEST_BYTES:
            raise RequestError("request-too-large", "request exceeds 16384 bytes")
    if not chunks:
        raise RequestError("invalid-json", "request must be one UTF-8 JSON object")
    return b"".join(chunks)


def serve():
    settings = environment()
    settings["socket"].parent.mkdir(parents=True, exist_ok=True, mode=0o750)
    if settings["socket"].exists() or settings["socket"].is_symlink():
        settings["socket"].unlink()
    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    listener.bind(str(settings["socket"]))
    os.chmod(settings["socket"], 0o660)
    listener.listen(16)
    while True:
        connection, _ = listener.accept()
        with connection:
            request_id = None
            try:
                _, uid, _ = struct.unpack("3i", connection.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i")))
                if uid != settings["expected_uid"]:
                    raise RequestError("unauthorized-peer", "peer is not the Bedrock API service account")
                raw = receive(connection)
                try:
                    decoded = json.loads(raw.decode("utf-8"))
                    request_id = decoded.get("request_id") if isinstance(decoded, dict) else None
                except (UnicodeDecodeError, json.JSONDecodeError):
                    pass
                result = execute(raw, settings)
            except RequestError as error:
                result = response(request_id, "rejected", error={"code": error.code, "message": error.message})
            except (OSError, RuntimeError, subprocess.SubprocessError, json.JSONDecodeError):
                result = response(request_id, "failed", error={"code": "internal-error", "message": "action broker could not safely complete the request"})
            connection.sendall(json.dumps(result, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n")


if __name__ == "__main__":
    serve()
