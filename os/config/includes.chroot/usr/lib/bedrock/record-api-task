#!/usr/bin/python3
import errno
import fcntl
import grp
import json
import os
import pathlib
import re
import stat
import sys
import tempfile
import time

STATES = {"queued", "running", "succeeded", "failed", "cancelled"}
UNITS = {"bytes", "items", "percent", "steps"}
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")

def fail(message: str) -> None:
    raise SystemExit(f"error: {message}")

def valid_task(item: object) -> bool:
    if not isinstance(item, dict) or set(item) != {"id", "kind", "state", "created_unix", "updated_unix", "progress"}:
        return False
    progress = item["progress"]
    return bool(
        isinstance(item["id"], str) and NAME.fullmatch(item["id"]) and
        isinstance(item["kind"], str) and NAME.fullmatch(item["kind"]) and item["state"] in STATES and
        type(item["created_unix"]) is int and type(item["updated_unix"]) is int and
        0 <= item["created_unix"] <= item["updated_unix"] and isinstance(progress, dict) and
        set(progress) == {"current", "total", "unit"} and type(progress["current"]) is int and
        type(progress["total"]) is int and 0 <= progress["current"] <= progress["total"] and
        progress["total"] > 0 and progress["unit"] in UNITS
    )

def valid_state(value: object) -> bool:
    return bool(isinstance(value, dict) and set(value) == {"schema", "generated_unix", "tasks"}
                and value["schema"] == 1 and type(value["generated_unix"]) is int and value["generated_unix"] >= 0
                and isinstance(value["tasks"], list) and len(value["tasks"]) <= 256
                and all(valid_task(item) for item in value["tasks"]))

def load(path: pathlib.Path) -> dict:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return {"schema": 1, "generated_unix": 0, "tasks": []}
    if not stat.S_ISREG(info.st_mode) or info.st_size > 1048576:
        fail("task state is unsafe")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError, json.JSONDecodeError):
        fail("task state is invalid")
    if not valid_state(value):
        fail("task state is invalid")
    return value

def atomic(path: pathlib.Path, value: object, mode: int, group: int | None, raw: bool = False) -> None:
    handle, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as output:
            if os.environ.get("BEDROCK_API_TASK_TEST_MODE") == "1" and os.environ.get("BEDROCK_API_TASK_FAIL_WRITE") == path.name:
                raise OSError(errno.ENOSPC, "injected task-state write failure")
            if raw:
                output.write(value)
            else:
                json.dump(value, output, sort_keys=True, separators=(",", ":"))
                output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.chmod(temporary, mode)
        if group is not None:
            os.chown(temporary, 0, group)
        os.replace(temporary, path)
        directory_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(directory_fd)
        finally:
            os.close(directory_fd)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)

def read_bounded(path: pathlib.Path, limit: int) -> str:
    descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
    with os.fdopen(descriptor, "r", encoding="utf-8") as source:
        info = os.fstat(source.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            fail("transaction state is unsafe")
        value = source.read(limit + 1)
        if len(value.encode("utf-8")) > limit:
            fail("transaction state is oversized")
        return value

def validate_audit(raw: str) -> None:
    if not isinstance(raw, str) or len(raw.encode("utf-8")) > 1048576:
        fail("audit state is oversized")
    for line in raw.splitlines():
        if not line.strip():
            continue
        event = json.loads(line)
        if not isinstance(event, dict) or set(event) != {"id", "category", "action", "outcome", "occurred_unix"}:
            fail("audit state is invalid")
        if any(not isinstance(event[key], str) or not event[key] or len(event[key]) > limit
               for key, limit in (("id", 128), ("category", 64), ("action", 64))):
            fail("audit fields are invalid")
        if event["outcome"] not in {"succeeded", "failed", "denied"} or type(event["occurred_unix"]) is not int or event["occurred_unix"] < 0:
            fail("audit outcome is invalid")

def checkpoint(name: str, test_mode: bool) -> None:
    if test_mode and os.environ.get("BEDROCK_API_TASK_CRASH_AFTER") == name:
        os._exit(86)

def recover_transaction(directory: pathlib.Path, group: int | None, test_mode: bool) -> None:
    journal = directory / "task-transaction.json"
    try:
        transaction = json.loads(read_bounded(journal, 4194304))
    except FileNotFoundError:
        return
    if not isinstance(transaction, dict) or set(transaction) != {"schema", "tasks", "audit"} or transaction["schema"] != 1 or not valid_state(transaction["tasks"]):
        fail("task transaction is invalid")
    validate_audit(transaction["audit"])
    atomic(directory / "audit.jsonl", transaction["audit"], 0o640, group, raw=True)
    checkpoint("audit", test_mode)
    atomic(directory / "tasks.json", transaction["tasks"], 0o640, group)
    checkpoint("tasks", test_mode)
    journal.unlink()
    descriptor = os.open(directory, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
    try:
        os.fsync(descriptor)
    finally:
        os.close(descriptor)

def main() -> None:
    recover_only = sys.argv[1:] == ["--recover"]
    if not recover_only:
        if len(sys.argv) != 8:
            fail("usage: record-api-task ID KIND STATE CREATED CURRENT TOTAL UNIT | --recover")
        task_id, kind, state, created_text, current_text, total_text, unit = sys.argv[1:]
        if not NAME.fullmatch(task_id) or not NAME.fullmatch(kind) or state not in STATES or unit not in UNITS:
            fail("task fields are invalid")
        try:
            created, current, total = int(created_text), int(current_text), int(total_text)
        except ValueError:
            fail("task counters are invalid")
        now = int(os.environ.get("BEDROCK_API_TASK_NOW", str(int(time.time()))))
        if min(created, now, current) < 0 or total <= 0 or current > total or now < created:
            fail("task counters are invalid")
    test_mode = os.environ.get("BEDROCK_API_TASK_TEST_MODE") == "1"
    if not test_mode and os.geteuid() != 0:
        fail("recording API tasks requires root")
    directory = pathlib.Path(os.environ.get("BEDROCK_API_TASK_STATE_DIR", "/var/lib/bedrock/api"))
    directory.mkdir(mode=0o750, parents=True, exist_ok=True)
    if not directory.is_dir() or directory.is_symlink():
        fail("API state directory is unsafe")
    tasks_path, audit_path, lock_path = directory / "tasks.json", directory / "audit.jsonl", directory / "tasks.lock"
    group = None if test_mode else grp.getgrnam("bedrock-api").gr_gid
    lock_fd = os.open(lock_path, os.O_RDWR | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0), 0o600)
    with os.fdopen(lock_fd, "a+") as lock:
        if not stat.S_ISREG(os.fstat(lock.fileno()).st_mode):
            fail("task lock is unsafe")
        os.fchmod(lock.fileno(), 0o600)
        fcntl.flock(lock, fcntl.LOCK_EX)
        recover_transaction(directory, group, test_mode)
        if recover_only:
            return
        value = load(tasks_path)
        previous = next((item for item in value["tasks"] if isinstance(item, dict) and item.get("id") == task_id), None)
        if previous:
            if previous.get("kind") != kind or previous.get("created_unix") != created or now < previous.get("updated_unix", -1) or current < previous.get("progress", {}).get("current", -1):
                fail("task update regresses or changes identity")
            if previous.get("state") in {"succeeded", "failed", "cancelled"} and state != previous["state"]:
                fail("terminal task cannot change state")
            if previous["progress"]["total"] != total or previous["progress"]["unit"] != unit:
                fail("task progress definition cannot change")
            if previous["state"] == "running" and state == "queued":
                fail("running task cannot return to queued")
        task = {"id": task_id, "kind": kind, "state": state, "created_unix": created, "updated_unix": now,
                "progress": {"current": current, "total": total, "unit": unit}}
        remaining = [item for item in value["tasks"] if not (isinstance(item, dict) and item.get("id") == task_id)]
        remaining.append(task)
        active = [item for item in remaining if item["state"] in {"queued", "running"}]
        if len(active) > 256:
            fail("too many active tasks")
        terminal_capacity = 256 - len(active)
        if terminal_capacity == 0 and task["state"] in {"succeeded", "failed", "cancelled"} and previous is None:
            fail("task state is full of active tasks")
        terminals = sorted((item for item in remaining if item["state"] not in {"queued", "running"}),
                           key=lambda item: item["updated_unix"])
        remaining = sorted(active + (terminals[-terminal_capacity:] if terminal_capacity else []),
                           key=lambda item: item["updated_unix"])
        terminal_transition = state in {"succeeded", "failed", "cancelled"} and (not previous or previous.get("state") != state)
        next_state = {"schema": 1, "generated_unix": now, "tasks": remaining}
        if terminal_transition:
            try:
                audit = read_bounded(audit_path, 1048576)
            except FileNotFoundError:
                if audit_path.is_symlink():
                    fail("audit state is indirect")
                audit = ""
            validate_audit(audit)
            event = {"id": f"{task_id}-{now}", "category": "task", "action": kind,
                     "outcome": "succeeded" if state == "succeeded" else "failed", "occurred_unix": now}
            # The read API accepts at most 1,000 retained events and returns the newest 100.
            events = [json.loads(line) for line in audit.splitlines() if line.strip()][-999:]
            events.append(event)
            audit = "".join(json.dumps(item, sort_keys=True, separators=(",", ":")) + "\n" for item in events)
            validate_audit(audit)
            atomic(directory / "task-transaction.json", {"schema": 1, "tasks": next_state, "audit": audit}, 0o600, None)
            checkpoint("journal", test_mode)
            recover_transaction(directory, group, test_mode)
        else:
            atomic(tasks_path, next_state, 0o640, group)

if __name__ == "__main__":
    main()
