#!/usr/bin/python3
import os
import pathlib
import re

credentials = os.environ.get("CREDENTIALS_DIRECTORY", "")
if not re.fullmatch(r"/[A-Za-z0-9_./@-]+", credentials) or ".." in credentials.split("/"):
    raise SystemExit("invalid systemd credentials directory")
for name in ("tls-cert", "tls-key"):
    credential = pathlib.Path(credentials) / name
    if not credential.is_file() or credential.is_symlink():
        raise SystemExit("gateway TLS credential is unavailable or indirect")
runtime = pathlib.Path("/run/bedrock-web")
if not runtime.is_dir() or runtime.is_symlink():
    raise SystemExit("gateway runtime directory is unavailable or indirect")
template = pathlib.Path("/etc/bedrock/web-gateway.conf").read_text(encoding="utf-8")
if template.count("@@CREDENTIALS_DIRECTORY@@") != 2:
    raise SystemExit("gateway TLS template is invalid")
descriptor = os.open(runtime / "nginx.conf", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
with os.fdopen(descriptor, "w", encoding="utf-8") as output:
    output.write(template.replace("@@CREDENTIALS_DIRECTORY@@", credentials))
    output.flush()
    os.fsync(output.fileno())
