#!/bin/sh
set -eu

[ "$#" -eq 1 ] || { printf 'usage: %s TOKEN_NAME\n' "$0" >&2; exit 2; }
name=$1
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
printf '%s' "$name" | grep -Eq '^[a-z][a-z0-9-]{0,30}[a-z0-9]$' || fail "API token name is invalid"
for tool in jq openssl sha256sum; do command -v "$tool" >/dev/null 2>&1 || fail "$tool is required"; done
if [ "${BEDROCK_API_TEST_MODE:-0}" = 1 ]; then
  directory=${BEDROCK_API_STATE_ROOT:?test mode requires BEDROCK_API_STATE_ROOT}
  state=${BEDROCK_API_TOKENS:?test mode requires BEDROCK_API_TOKENS}
  now=${BEDROCK_API_NOW:-2026-08-31T00:00:00Z}
  token=${BEDROCK_API_TOKEN:-$(openssl rand -hex 32)}
else
  [ "$(id -u)" -eq 0 ] || fail "API token creation requires root"
  directory=/var/lib/bedrock/api
  state=$directory/tokens.json
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  token=$(openssl rand -hex 32)
fi
printf '%s' "$token" | grep -Eq '^[0-9a-f]{64}$' || fail "API token generation failed"
[ -e "$directory" ] || mkdir -p "$directory"
[ -d "$directory" ] && [ ! -L "$directory" ] || fail "API state directory is indirect"
chmod 0750 "$directory"
if [ "${BEDROCK_API_TEST_MODE:-0}" != 1 ]; then chown root:bedrock-api "$directory"; fi
if [ ! -e "$state" ]; then install -m 0640 /usr/share/bedrock/empty-api-tokens.json "$state"; fi
[ -f "$state" ] && [ ! -L "$state" ] || fail "API token state is missing or indirect"
valid='(keys|sort)==(["schema","tokens"]|sort) and .schema==1 and (.tokens|type=="array" and length<=16) and
  all(.tokens[]; (keys|sort)==(["created_at","name","revoked","sha256"]|sort) and
    (.name|type)=="string" and (.name|test("^[a-z][a-z0-9-]{0,30}[a-z0-9]$")) and
    (.sha256|type)=="string" and (.sha256|test("^[0-9a-f]{64}$")) and
    (.created_at|type)=="string" and (.revoked|type)=="boolean") and
  (([.tokens[].name]|unique|length)==(.tokens|length)) and
  all(.tokens[]; .name!=$name or .revoked==true) and
  ((.tokens|length)<16 or any(.tokens[]; .name==$name and .revoked==true))'
jq -e --arg name "$name" "$valid" "$state" >/dev/null || fail "API token state is invalid, full, or the name is active"
hash=$(printf '%s' "$token" | sha256sum | awk '{print $1}')
lock=$directory/.token.lock
mkdir "$lock" 2>/dev/null || fail "another API token operation is running"
temporary=$(mktemp "$directory/.tokens.XXXXXX")
cleanup() { status=$?; rm -f "$temporary"; rmdir "$lock" 2>/dev/null || true; exit "$status"; }
trap cleanup EXIT
trap 'exit 130' INT TERM
jq -e --arg name "$name" "$valid" "$state" >/dev/null || fail "API token state changed concurrently"
jq -S --arg name "$name" --arg hash "$hash" --arg created "$now" '.tokens = ([.tokens[] | select(.name!=$name)] + [{name:$name,sha256:$hash,created_at:$created,revoked:false}]) | .tokens |= sort_by(.name)' "$state" > "$temporary"
chmod 0640 "$temporary"
if [ "${BEDROCK_API_TEST_MODE:-0}" != 1 ]; then chown root:bedrock-api "$temporary"; fi
mv "$temporary" "$state"; temporary=
trap - EXIT INT TERM; rmdir "$lock"
jq -S -n --arg name "$name" --arg token "$token" --arg created "$now" '{schema:1,status:"created",name:$name,token:$token,created_at:$created,shown_once:true}'
