    def do_POST(self) -> None:
        if not authorized(self.headers.get("Authorization")):
            self.send_json(401, {"schema": 1, "error": "unauthorized"})
            return
        create = self.path == "/api/v1/vms"
        power = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/power", self.path)
        snapshots = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/snapshots", self.path)
        clone = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/clone", self.path)
        resources = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/resources", self.path)
        images = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/images", self.path)
        networks = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/networks", self.path)
        passthrough = re.fullmatch(r"/api/v1/vms/([a-z][a-z0-9-]{0,30}[a-z0-9])/passthrough", self.path)
        remote_device = re.fullmatch(r"/api/v1/remote/devices/([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})", self.path)
        pairing_approval = re.fullmatch(r"/api/v1/remote/pairings/([0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12})/approve", self.path)
        image_conversion = re.fullmatch(r"/api/v1/images/([a-z][a-z0-9-]{0,30}[a-z0-9])/convert", self.path)
        backup_run = re.fullmatch(r"/api/v1/backups/([a-z][a-z0-9-]{0,31})/run", self.path)
        backup_restore_latest = re.fullmatch(r"/api/v1/backups/([a-z][a-z0-9-]{0,31})/restore-latest", self.path)
        app_control = re.fullmatch(r"/api/v1/apps/([a-z][a-z0-9-]{0,31})/power", self.path)
        app_update = re.fullmatch(r"/api/v1/apps/([a-z][a-z0-9-]{0,31})/update", self.path)
        app_install = re.fullmatch(r"/api/v1/apps/([a-z][a-z0-9-]{0,31})/install", self.path)
        if not create and not power and not snapshots and not clone and not resources and not images and not networks and not passthrough and not remote_device and not pairing_approval and not image_conversion and not backup_run and not backup_restore_latest and not app_control and not app_update and not app_install:
            self.send_json(405, {"schema": 1, "error": "method-not-allowed"})
            return
        if self.headers.get("Transfer-Encoding") is not None or self.headers.get("Content-Type") != "application/json":
            self.send_json(400, {"schema": 1, "error": "invalid-request"})
            return
        try:
            length = int(self.headers.get("Content-Length", ""))
            if not 1 <= length <= 4096:
                raise ValueError("invalid body length")
            body = json.loads(self.rfile.read(length).decode("utf-8"))
            if create:
                result = vm_create_action(self.headers.get("Idempotency-Key", ""), body)
            elif images or networks:
                target = (images or networks).group(1)
                result = vm_attachment_action(self.headers.get("Idempotency-Key", ""), target, body, "image" if images else "network")
            elif passthrough:
                result = vm_passthrough_action(self.headers.get("Idempotency-Key", ""), passthrough.group(1), body)
            elif remote_device:
                result = remote_device_action(self.headers.get("Idempotency-Key", ""), remote_device.group(1), body)
            elif pairing_approval:
                result = remote_pairing_approval_action(self.headers.get("Idempotency-Key", ""), pairing_approval.group(1), body)
            elif image_conversion:
                result = image_conversion_action(self.headers.get("Idempotency-Key", ""), image_conversion.group(1), body)
            elif backup_run:
                result = backup_run_action(self.headers.get("Idempotency-Key", ""), backup_run.group(1), body)
            elif backup_restore_latest:
                result = backup_restore_latest_action(self.headers.get("Idempotency-Key", ""), backup_restore_latest.group(1), body)
            elif app_control:
                result = app_control_action(self.headers.get("Idempotency-Key", ""), app_control.group(1), body)
            elif app_update:
                result = app_control_action(self.headers.get("Idempotency-Key", ""), app_update.group(1), body, "update-latest")
            elif app_install:
                result = app_control_action(self.headers.get("Idempotency-Key", ""), app_install.group(1), body, "install-staged")
            else:
                target = (power or snapshots or clone or resources).group(1)
                action = vm_control_action if power else vm_snapshot_action if snapshots else vm_clone_action if clone else vm_resource_action
                result = action(self.headers.get("Idempotency-Key", ""), target, body)
        except (ValueError, UnicodeDecodeError, json.JSONDecodeError):
            self.send_json(400, {"schema": 1, "error": "invalid-request"})
            return
        except (OSError, socket.timeout):
            self.send_json(503, {"schema": 1, "error": "action-broker-unavailable"})
            return
        if result["status"] == "succeeded":
            self.send_json(200, result)
        elif result["error"]["code"] == "idempotency-conflict":
            self.send_json(409, result)
        elif result["error"]["code"] == "action-failed":
            self.send_json(422, result)
        else:
            self.send_json(503, {"schema": 1, "error": "action-broker-unavailable"})

