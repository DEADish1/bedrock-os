#!/usr/bin/python3
import hashlib
import hmac
import json
import os
import pathlib
import re
import socketserver
import stat
from http.server import BaseHTTPRequestHandler

SOCKET = pathlib.Path(os.environ.get("BEDROCK_API_SOCKET", "/run/bedrock-api/api.sock"))
TOKENS = pathlib.Path(os.environ.get("BEDROCK_API_TOKENS", "/var/lib/bedrock/api/tokens.json"))
CAPABILITIES = pathlib.Path(os.environ.get("BEDROCK_API_CAPABILITIES", "/var/lib/bedrock/virtualization/capabilities.json"))
HARDWARE = pathlib.Path(os.environ.get("BEDROCK_API_HARDWARE", "/var/lib/bedrock/hardware/inventory.json"))
STORAGE = pathlib.Path(os.environ.get("BEDROCK_API_STORAGE", "/var/lib/bedrock/storage/health.json"))
ALERTS = pathlib.Path(os.environ.get("BEDROCK_API_ALERTS", "/var/lib/bedrock/storage/alerts.json"))
VMS = pathlib.Path(os.environ.get("BEDROCK_API_VMS", "/var/lib/bedrock/virtualization/status.json"))
UPDATES = pathlib.Path(os.environ.get("BEDROCK_API_UPDATES", "/var/lib/bedrock/update/last-check.json"))
TASKS = pathlib.Path(os.environ.get("BEDROCK_API_TASKS", "/var/lib/bedrock/api/tasks.json"))
AUDIT = pathlib.Path(os.environ.get("BEDROCK_API_AUDIT", "/var/lib/bedrock/api/audit.jsonl"))
OPENAPI = pathlib.Path(os.environ.get("BEDROCK_API_OPENAPI", "/usr/share/bedrock/api/openapi-v1.json"))
REMOTE = pathlib.Path(os.environ.get("BEDROCK_API_REMOTE", "/var/lib/bedrock/remote/status.json"))

TASK_STATES = {"queued", "running", "succeeded", "failed", "cancelled"}
TASK_UNITS = {"bytes", "items", "percent", "steps"}
DEVICE_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")

def regular_json(path: pathlib.Path, limit: int) -> object:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
            raise ValueError("unsafe state file")
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        after = os.fstat(descriptor)
        if remaining == 0 or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("state changed while being read")
        return json.loads(b"".join(chunks).decode("utf-8"))
    finally:
        os.close(descriptor)

def authorized(value: str | None) -> bool:
    if not value or not value.startswith("Bearer "):
        return False
    token = value[7:]
    if len(token) != 64 or any(c not in "0123456789abcdef" for c in token):
        return False
    digest = hashlib.sha256(token.encode("ascii")).hexdigest()
    try:
        state = regular_json(TOKENS, 65536)
        if set(state) != {"schema", "tokens"} or state["schema"] != 1 or not isinstance(state["tokens"], list):
            return False
        return any(isinstance(item, dict) and set(item) == {"name", "sha256", "created_at", "revoked"} and item["revoked"] is False and hmac.compare_digest(item["sha256"], digest) for item in state["tokens"])
    except (OSError, ValueError, json.JSONDecodeError, TypeError):
        return False

def bounded_string(value: object, maximum: int) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum or any(ord(char) < 32 for char in value):
        raise ValueError("invalid string")
    return value

def task_feed() -> dict:
    value = regular_json(TASKS, 1048576)
    if not isinstance(value, dict) or set(value) != {"schema", "generated_unix", "tasks"} or value["schema"] != 1:
        raise ValueError("invalid task state")
    if type(value["generated_unix"]) is not int or value["generated_unix"] < 0 or not isinstance(value["tasks"], list) or len(value["tasks"]) > 256:
        raise ValueError("invalid task state")
    tasks = []
    for item in value["tasks"]:
        if not isinstance(item, dict) or set(item) != {"id", "kind", "state", "created_unix", "updated_unix", "progress"}:
            raise ValueError("invalid task")
        task_id = bounded_string(item["id"], 64)
        kind = bounded_string(item["kind"], 64)
        state = item["state"]
        created = item["created_unix"]
        updated = item["updated_unix"]
        if state not in TASK_STATES or type(created) is not int or type(updated) is not int or created < 0 or updated < created:
            raise ValueError("invalid task")
        progress = item["progress"]
        if not isinstance(progress, dict) or set(progress) != {"current", "total", "unit"}:
            raise ValueError("invalid task progress")
        current, total, unit = progress["current"], progress["total"], progress["unit"]
        if type(current) is not int or type(total) is not int or current < 0 or total <= 0 or current > total or unit not in TASK_UNITS:
            raise ValueError("invalid task progress")
        tasks.append({"id": task_id, "kind": kind, "state": state, "created_unix": created,
                      "updated_unix": updated, "progress": {"current": current, "total": total, "unit": unit}})
    return {"schema": 1, "generated_unix": value["generated_unix"], "tasks": tasks}

def alert_feed() -> dict:
    value = regular_json(ALERTS, 1048576)
    if not isinstance(value, dict) or value.get("schema") != 1 or type(value.get("generated_unix")) is not int or value["generated_unix"] < 0:
        raise ValueError("invalid alerts")
    active = value.get("active")
    if not isinstance(active, list) or len(active) > 256 or value.get("active_count") != len(active):
        raise ValueError("invalid alerts")
    safe = []
    for item in active:
        if not isinstance(item, dict):
            raise ValueError("invalid alert")
        safe.append({
            "id": bounded_string(item.get("alert_id"), 128),
            "kind": bounded_string(item.get("kind"), 64),
            "severity": bounded_string(item.get("severity"), 16),
            "first_seen_unix": item.get("first_seen_unix"),
            "last_seen_unix": item.get("last_seen_unix"),
        })
        if safe[-1]["severity"] not in {"warning", "critical"} or any(type(safe[-1][key]) is not int or safe[-1][key] < 0 for key in ("first_seen_unix", "last_seen_unix")):
            raise ValueError("invalid alert")
    return {"schema": 1, "generated_unix": value["generated_unix"], "attention_required": bool(safe), "alerts": safe}

def audit_feed() -> dict:
    events = []
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(AUDIT, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > 1048576:
            raise ValueError("unsafe audit file")
        with os.fdopen(descriptor, encoding="utf-8", closefd=False) as source:
            for line in source:
                if not line.strip():
                    continue
                item = json.loads(line)
                if not isinstance(item, dict) or set(item) != {"id", "category", "action", "outcome", "occurred_unix"}:
                    raise ValueError("invalid audit event")
                event = {
                    "id": bounded_string(item["id"], 128),
                    "category": bounded_string(item["category"], 64),
                    "action": bounded_string(item["action"], 64),
                    "outcome": bounded_string(item["outcome"], 16),
                    "occurred_unix": item["occurred_unix"],
                }
                if event["outcome"] not in {"succeeded", "failed", "denied"} or type(event["occurred_unix"]) is not int or event["occurred_unix"] < 0:
                    raise ValueError("invalid audit event")
                events.append(event)
                if len(events) > 1000:
                    raise ValueError("too many audit events")
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("audit changed while being read")
    finally:
        os.close(descriptor)
    return {"schema": 1, "events": events[-100:]}

def remote_feed() -> dict:
    value = regular_json(REMOTE, 262144)
    if not isinstance(value, dict) or set(value) != {"schema", "devices"} or value["schema"] != 1 or not isinstance(value["devices"], list) or len(value["devices"]) > 128:
        raise ValueError("invalid remote status")
    fields = {"id", "name", "created_unix", "expires_unix", "revoked", "expired", "last_seen_unix"}
    for item in value["devices"]:
        if not isinstance(item, dict) or set(item) != fields or not DEVICE_ID.fullmatch(bounded_string(item["id"], 64)) or not isinstance(item["name"], str) or not 1 <= len(item["name"]) <= 64 or any(ord(char) < 32 for char in item["name"]):
            raise ValueError("invalid remote device")
        if type(item["created_unix"]) is not int or type(item["expires_unix"]) is not int or not 0 <= item["created_unix"] < item["expires_unix"] or type(item["revoked"]) is not bool or type(item["expired"]) is not bool or (item["last_seen_unix"] is not None and (type(item["last_seen_unix"]) is not int or item["last_seen_unix"] < 0)):
            raise ValueError("invalid remote device")
    return value

def dashboard() -> dict:
    result = {"schema": 1, "components": {}}
    components = result["components"]
    readers = {
        "hardware": lambda value: {
            "architecture": value["cpu"]["architecture"],
            "logical_processors": value["cpu"]["logical_processors"],
            "virtualization_supported": value["cpu"]["virtualization_supported"],
            "memory_total_bytes": value["memory"]["total_bytes"],
            "disk_count": len(value["disks"]), "network_count": len(value["networks"]),
        },
        "storage": lambda value: {
            "generated_unix": value["generated_unix"], "overall": value["overall"],
            "disk_count": len(value["disks"]), "read_only": value["read_only"],
        },
        "alerts": lambda value: {
            "generated_unix": value["generated_unix"], "attention_required": value["attention_required"],
            "active_count": value["active_count"],
        },
        "vms": lambda value: {
            "generated_unix": value["generated_unix"], "total": len(value["domains"]),
            "running": sum(item["state"] == "running" for item in value["domains"]),
        },
        "updates": lambda value: {
            key: value[key] for key in ("status", "checked_unix", "installed_generation", "available_generation", "available_version", "available_channel")
        },
    }
    for name, path in (("hardware", HARDWARE), ("storage", STORAGE), ("alerts", ALERTS), ("vms", VMS), ("updates", UPDATES)):
        try:
            value = regular_json(path, 1048576)
            if not isinstance(value, dict) or value.get("schema") not in (1, 2):
                raise ValueError("invalid state schema")
            components[name] = {"status": "available", "data": readers[name](value)}
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            components[name] = {"status": "unavailable"}
    result["partial"] = any(value["status"] != "available" for value in components.values())
    return result

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "BedrockAPI/1"
    sys_version = ""

    def send_json(self, status: int, value: object) -> None:
        body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if not authorized(self.headers.get("Authorization")):
            self.send_json(401, {"schema": 1, "error": "unauthorized"})
            return
        if self.path == "/api/v1/health":
            self.send_json(200, {"schema": 1, "status": "ok", "api_version": "v1"})
        elif self.path == "/api/v1/openapi.json":
            try:
                self.send_json(200, regular_json(OPENAPI, 262144))
            except (OSError, ValueError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "schema-unavailable"})
        elif self.path == "/api/v1/virtualization/capabilities":
            try:
                data = regular_json(CAPABILITIES, 65536)
                self.send_json(200, {"schema": 1, "data": data})
            except (OSError, ValueError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "capabilities-unavailable"})
        elif self.path == "/api/v1/dashboard":
            self.send_json(200, dashboard())
        elif self.path == "/api/v1/tasks":
            try:
                self.send_json(200, task_feed())
            except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "tasks-unavailable"})
        elif self.path == "/api/v1/alerts":
            try:
                self.send_json(200, alert_feed())
            except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "alerts-unavailable"})
        elif self.path == "/api/v1/audit":
            try:
                self.send_json(200, audit_feed())
            except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "audit-unavailable"})
        elif self.path == "/api/v1/remote/devices":
            try:
                self.send_json(200, remote_feed())
            except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "remote-status-unavailable"})
        else:
            self.send_json(404, {"schema": 1, "error": "not-found"})

    def do_POST(self) -> None:
        if not authorized(self.headers.get("Authorization")):
            self.send_json(401, {"schema": 1, "error": "unauthorized"})
            return
        self.send_json(405, {"schema": 1, "error": "read-only-foundation"})

    def log_message(self, _format: str, *_args: object) -> None:
        return

class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
    daemon_threads = True
    request_queue_size = 16

def main() -> None:
    SOCKET.parent.mkdir(mode=0o750, parents=True, exist_ok=True)
    if SOCKET.exists() or SOCKET.is_socket():
        info = SOCKET.lstat()
        if not stat.S_ISSOCK(info.st_mode):
            raise SystemExit("refusing to replace non-socket API path")
        SOCKET.unlink()
    with Server(str(SOCKET), Handler) as server:
        os.chmod(SOCKET, 0o660)
        server.serve_forever(poll_interval=0.25)

if __name__ == "__main__":
    main()
