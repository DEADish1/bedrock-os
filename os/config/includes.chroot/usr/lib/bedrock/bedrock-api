TASK_STATES = {"queued", "running", "succeeded", "failed", "cancelled"}
TASK_UNITS = {"bytes", "items", "percent", "steps"}
DEVICE_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")

def regular_json(path: pathlib.Path, limit: int) -> object:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
            raise ValueError("unsafe state file")
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        after = os.fstat(descriptor)
        if remaining == 0 or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("state changed while being read")
        return json.loads(b"".join(chunks).decode("utf-8"))
    finally:
        os.close(descriptor)

def authorized(value: str | None) -> bool:
    if not value or not value.startswith("Bearer "):
        return False
    token = value[7:]
    if len(token) != 64 or any(c not in "0123456789abcdef" for c in token):
        return False
    digest = hashlib.sha256(token.encode("ascii")).hexdigest()
    try:
        state = regular_json(TOKENS, 65536)
        if set(state) != {"schema", "tokens"} or state["schema"] != 1 or not isinstance(state["tokens"], list):
            return False
        return any(isinstance(item, dict) and set(item) == {"name", "sha256", "created_at", "revoked"} and item["revoked"] is False and hmac.compare_digest(item["sha256"], digest) for item in state["tokens"])
    except (OSError, ValueError, json.JSONDecodeError, TypeError):
        return False

def bounded_string(value: object, maximum: int) -> str:
    if not isinstance(value, str) or not value or len(value) > maximum or any(ord(char) < 32 for char in value):
        raise ValueError("invalid string")
    return value

def task_feed() -> dict:
    value = regular_json(TASKS, 1048576)
    if not isinstance(value, dict) or set(value) != {"schema", "generated_unix", "tasks"} or value["schema"] != 1:
        raise ValueError("invalid task state")
    if type(value["generated_unix"]) is not int or value["generated_unix"] < 0 or not isinstance(value["tasks"], list) or len(value["tasks"]) > 256:
        raise ValueError("invalid task state")
    tasks = []
    for item in value["tasks"]:
        if not isinstance(item, dict) or set(item) != {"id", "kind", "state", "created_unix", "updated_unix", "progress"}:
            raise ValueError("invalid task")
        task_id = bounded_string(item["id"], 64)
        kind = bounded_string(item["kind"], 64)
        state = item["state"]
        created = item["created_unix"]
        updated = item["updated_unix"]
        if state not in TASK_STATES or type(created) is not int or type(updated) is not int or created < 0 or updated < created:
            raise ValueError("invalid task")
        progress = item["progress"]
        if not isinstance(progress, dict) or set(progress) != {"current", "total", "unit"}:
            raise ValueError("invalid task progress")
        current, total, unit = progress["current"], progress["total"], progress["unit"]
        if type(current) is not int or type(total) is not int or current < 0 or total <= 0 or current > total or unit not in TASK_UNITS:
            raise ValueError("invalid task progress")
        tasks.append({"id": task_id, "kind": kind, "state": state, "created_unix": created,
                      "updated_unix": updated, "progress": {"current": current, "total": total, "unit": unit}})
    return {"schema": 1, "generated_unix": value["generated_unix"], "tasks": tasks}

def alert_feed() -> dict:
    value = regular_json(ALERTS, 1048576)
    if not isinstance(value, dict) or value.get("schema") != 1 or type(value.get("generated_unix")) is not int or value["generated_unix"] < 0:
        raise ValueError("invalid alerts")
    active = value.get("active")
    if not isinstance(active, list) or len(active) > 256 or value.get("active_count") != len(active):
        raise ValueError("invalid alerts")
    safe = []
    for item in active:
        if not isinstance(item, dict):
            raise ValueError("invalid alert")
        safe.append({
            "id": bounded_string(item.get("alert_id"), 128),
            "kind": bounded_string(item.get("kind"), 64),
            "severity": bounded_string(item.get("severity"), 16),
            "first_seen_unix": item.get("first_seen_unix"),
            "last_seen_unix": item.get("last_seen_unix"),
        })
        if safe[-1]["severity"] not in {"warning", "critical"} or any(type(safe[-1][key]) is not int or safe[-1][key] < 0 for key in ("first_seen_unix", "last_seen_unix")):
            raise ValueError("invalid alert")
    return {"schema": 1, "generated_unix": value["generated_unix"], "attention_required": bool(safe), "alerts": safe}

def audit_feed() -> dict:
    events = []
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(AUDIT, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > 1048576:
            raise ValueError("unsafe audit file")
        with os.fdopen(descriptor, encoding="utf-8", closefd=False) as source:
            for line in source:
                if not line.strip():
                    continue
                item = json.loads(line)
                if not isinstance(item, dict) or set(item) != {"id", "category", "action", "outcome", "occurred_unix"}:
                    raise ValueError("invalid audit event")
                event = {
                    "id": bounded_string(item["id"], 128),
                    "category": bounded_string(item["category"], 64),
                    "action": bounded_string(item["action"], 64),
                    "outcome": bounded_string(item["outcome"], 16),
                    "occurred_unix": item["occurred_unix"],
                }
                if event["outcome"] not in {"succeeded", "failed", "denied"} or type(event["occurred_unix"]) is not int or event["occurred_unix"] < 0:
                    raise ValueError("invalid audit event")
                events.append(event)
                if len(events) > 1000:
                    raise ValueError("too many audit events")
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("audit changed while being read")
    finally:
        os.close(descriptor)
    return {"schema": 1, "events": events[-100:]}

def remote_feed() -> dict:
    value = regular_json(REMOTE, 262144)
    if not isinstance(value, dict) or set(value) != {"schema", "devices"} or value["schema"] != 1 or not isinstance(value["devices"], list) or len(value["devices"]) > 128:
        raise ValueError("invalid remote status")
    fields = {"id", "name", "created_unix", "expires_unix", "revoked", "expired", "last_seen_unix"}
    for item in value["devices"]:
        if not isinstance(item, dict) or set(item) != fields or not DEVICE_ID.fullmatch(bounded_string(item["id"], 64)) or not isinstance(item["name"], str) or not 1 <= len(item["name"]) <= 64 or any(ord(char) < 32 for char in item["name"]):
            raise ValueError("invalid remote device")
        if type(item["created_unix"]) is not int or type(item["expires_unix"]) is not int or not 0 <= item["created_unix"] < item["expires_unix"] or type(item["revoked"]) is not bool or type(item["expired"]) is not bool or (item["last_seen_unix"] is not None and (type(item["last_seen_unix"]) is not int or item["last_seen_unix"] < 0)):
            raise ValueError("invalid remote device")
    return value

def app_feed() -> dict:
    value = regular_json(APPS, 262144)
    if not isinstance(value, dict) or set(value) != {"schema", "apps"} or value["schema"] != 1 or not isinstance(value["apps"], list) or len(value["apps"]) > 64:
        raise ValueError("invalid application status")
    fields = {"id", "name", "network", "port_count", "resources", "update_policy", "created_unix"}
    for item in value["apps"]:
        if not isinstance(item, dict) or set(item) != fields or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", bounded_string(item["id"], 32)) or not 1 <= len(bounded_string(item["name"], 64)) <= 64:
            raise ValueError("invalid application")
        resources = item["resources"]
        if item["network"] not in {"none", "bridge"} or item["update_policy"] not in {"manual", "notify"} or type(item["port_count"]) is not int or not 0 <= item["port_count"] <= 16 or type(item["created_unix"]) is not int or item["created_unix"] < 0:
            raise ValueError("invalid application")
        if not isinstance(resources, dict) or set(resources) != {"cpus", "memory_mib", "pids"} or type(resources["cpus"]) not in {int, float} or not .25 <= resources["cpus"] <= 16 or type(resources["memory_mib"]) is not int or not 128 <= resources["memory_mib"] <= 32768 or type(resources["pids"]) is not int or not 16 <= resources["pids"] <= 4096:
            raise ValueError("invalid application resources")
    return value

def backup_feed() -> dict:
    value = regular_json(BACKUPS, 262144)
    if not isinstance(value, dict) or set(value) != {"schema", "plans"} or value["schema"] != 1 or not isinstance(value["plans"], list) or len(value["plans"]) > 64:
        raise ValueError("invalid backup status")
    fields = {"id", "name", "kind", "schedule", "retention", "created_unix", "last_success_unix", "has_snapshot"}
    for item in value["plans"]:
        if not isinstance(item, dict) or set(item) != fields or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", bounded_string(item["id"], 32)) or not 1 <= len(bounded_string(item["name"], 64)) <= 64:
            raise ValueError("invalid backup plan")
        schedule, retention = item["schedule"], item["retention"]
        if item["kind"] not in {"local", "remote"} or type(item["created_unix"]) is not int or item["created_unix"] < 0 or (item["last_success_unix"] is not None and (type(item["last_success_unix"]) is not int or item["last_success_unix"] < 0)) or type(item["has_snapshot"]) is not bool:
            raise ValueError("invalid backup plan")
        if not isinstance(schedule, dict) or set(schedule) != {"frequency", "hour_utc", "weekday"} or schedule["frequency"] not in {"daily", "weekly"} or type(schedule["hour_utc"]) is not int or not 0 <= schedule["hour_utc"] <= 23 or (schedule["frequency"] == "daily" and schedule["weekday"] is not None) or (schedule["frequency"] == "weekly" and (type(schedule["weekday"]) is not int or not 0 <= schedule["weekday"] <= 6)):
            raise ValueError("invalid backup schedule")
        if not isinstance(retention, dict) or set(retention) != {"daily", "weekly", "monthly"} or any(type(retention[key]) is not int or not 0 <= retention[key] <= 365 for key in retention) or sum(retention.values()) < 1:
            raise ValueError("invalid backup retention")
    return value

def hardware_feed() -> dict:
    value = regular_json(HARDWARE, 1048576)
    if not isinstance(value, dict) or set(value) != {"schema", "cpu", "memory", "disks", "storage_controllers", "networks", "gpus", "usb_devices"} or value["schema"] != 2:
        raise ValueError("invalid hardware inventory")
    cpu, memory = value["cpu"], value["memory"]
    cpu_fields = {"architecture", "model", "logical_processors", "sockets", "cores_per_socket", "threads_per_core", "virtualization", "virtualization_supported"}
    if not isinstance(cpu, dict) or set(cpu) != cpu_fields or not isinstance(memory, dict) or set(memory) != {"total_bytes"}:
        raise ValueError("invalid hardware inventory")
    for key in ("logical_processors", "sockets", "cores_per_socket", "threads_per_core"):
        if type(cpu[key]) is not int or cpu[key] < 1:
            raise ValueError("invalid processor inventory")
    result = {"schema": 1, "cpu": {"architecture": bounded_string(cpu["architecture"], 32), "model": bounded_string(cpu["model"], 160), "logical_processors": cpu["logical_processors"], "sockets": cpu["sockets"], "cores_per_socket": cpu["cores_per_socket"], "threads_per_core": cpu["threads_per_core"], "virtualization": bounded_string(cpu["virtualization"], 32), "virtualization_supported": cpu["virtualization_supported"]}, "memory": {"total_bytes": memory["total_bytes"]}}
    if type(cpu["virtualization_supported"]) is not bool or type(memory["total_bytes"]) is not int or memory["total_bytes"] < 1:
        raise ValueError("invalid hardware inventory")
    collections = (value["disks"], value["storage_controllers"], value["networks"], value["gpus"], value["usb_devices"])
    if any(not isinstance(items, list) or len(items) > 256 for items in collections):
        raise ValueError("invalid hardware inventory")
    result["disks"] = [{"model": bounded_string(item["model"], 160), "vendor": bounded_string(item["vendor"], 80), "size_bytes": item["size_bytes"], "rotational": item["rotational"], "transport": bounded_string(item["transport"], 32), "removable": item["removable"]} for item in value["disks"] if isinstance(item, dict)]
    if len(result["disks"]) != len(value["disks"]) or any(type(item["size_bytes"]) is not int or item["size_bytes"] < 0 or type(item["rotational"]) is not bool or type(item["removable"]) is not bool for item in result["disks"]):
        raise ValueError("invalid disk inventory")
    result["storage_controllers"] = [{"class": bounded_string(item["class"], 32), "description": re.sub(r"^[0-9a-fA-F:.]+\s+", "", bounded_string(item["description"], 240))} for item in value["storage_controllers"] if isinstance(item, dict)]
    result["networks"] = [{"mtu": item["mtu"], "state": bounded_string(item["state"], 32), "link_type": bounded_string(item["link_type"], 32)} for item in value["networks"] if isinstance(item, dict)]
    result["gpus"] = [{"vendor": bounded_string(item["vendor"], 32), "driver": bounded_string(item["driver"], 64), "boot_vga": item["boot_vga"], "recognized_vendor": item["recognized_vendor"]} for item in value["gpus"] if isinstance(item, dict)]
    if len(result["storage_controllers"]) != len(value["storage_controllers"]) or len(result["networks"]) != len(value["networks"]) or len(result["gpus"]) != len(value["gpus"]) or any(type(item["mtu"]) is not int or item["mtu"] < 576 for item in result["networks"]) or any(type(item["boot_vga"]) is not bool or type(item["recognized_vendor"]) is not bool for item in result["gpus"]):
        raise ValueError("invalid hardware inventory")
    result["usb_device_count"] = len(value["usb_devices"])
    return result

def vm_feed() -> dict:
    value = regular_json(VMS, 1048576)
    if not isinstance(value, dict) or set(value) != {"schema", "generated_unix", "domains"} or value["schema"] != 1 or type(value["generated_unix"]) is not int or value["generated_unix"] < 0 or not isinstance(value["domains"], list) or len(value["domains"]) > 128:
        raise ValueError("invalid virtual machine status")
    fields = {"name", "state", "autostart", "vcpus", "memory_mib", "snapshot_count", "image_attachments", "network_attachments"}
    states = {"running", "paused", "shut off", "crashed", "in shutdown", "pmsuspended"}
    for item in value["domains"]:
        if not isinstance(item, dict) or set(item) != fields or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", bounded_string(item["name"], 32)) or item["state"] not in states or type(item["autostart"]) is not bool or type(item["vcpus"]) is not int or not 1 <= item["vcpus"] <= 256 or type(item["memory_mib"]) is not int or not 128 <= item["memory_mib"] <= 1048576 or type(item["snapshot_count"]) is not int or not 0 <= item["snapshot_count"] <= 4096:
            raise ValueError("invalid virtual machine")
        for attachments in (item["image_attachments"], item["network_attachments"]):
            if not isinstance(attachments, list) or len(attachments) > 64 or any(not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", bounded_string(name, 32)) for name in attachments) or len(set(attachments)) != len(attachments):
                raise ValueError("invalid virtual machine attachments")
    if len({item["name"] for item in value["domains"]}) != len(value["domains"]):
        raise ValueError("duplicate virtual machine")
    return value

def image_feed() -> dict:
    value = regular_json(IMAGES, 524288)
    if not isinstance(value, dict) or set(value) != {"schema", "images"} or value["schema"] != 1 or not isinstance(value["images"], list) or len(value["images"]) > 256:
        raise ValueError("invalid image status")
    fields = {"name", "type", "sha256", "size_bytes", "converted"}
    for item in value["images"]:
        if not isinstance(item, dict) or set(item) != fields or not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", bounded_string(item["name"], 32)) or item["type"] not in {"iso", "img", "qcow2", "vhdx", "vmdk"} or not re.fullmatch(r"[0-9a-f]{64}", bounded_string(item["sha256"], 64)) or type(item["size_bytes"]) is not int or not 1 <= item["size_bytes"] <= 4398046511104 or type(item["converted"]) is not bool:
            raise ValueError("invalid image")
    if len({item["name"] for item in value["images"]}) != len(value["images"]):
        raise ValueError("duplicate image")
    return value

def storage_feed() -> dict:
    value = regular_json(STORAGE, 1048576)
    expected = {"schema", "generated_unix", "overall", "read_only", "disks", "software_raid", "hardware_raid"}
    if not isinstance(value, dict) or set(value) != expected or value["schema"] != 1 or type(value["generated_unix"]) is not int or value["generated_unix"] < 0 or value["overall"] not in {"healthy", "attention", "limited"} or value["read_only"] is not True:
        raise ValueError("invalid storage status")
    disks = value["disks"]
    if not isinstance(disks, list) or len(disks) > 256:
        raise ValueError("invalid disk status")
    safe_disks = []
    for item in disks:
        if not isinstance(item, dict) or not {"size_bytes", "model", "transport", "smart"}.issubset(item) or type(item["size_bytes"]) is not int or item["size_bytes"] < 0:
            raise ValueError("invalid disk status")
        smart = item["smart"]
        if not isinstance(smart, dict) or not {"available", "temperature_c", "power_on_hours", "health"}.issubset(smart) or type(smart["available"]) is not bool or smart["health"] not in {"healthy", "failing", "standby", "unknown"}:
            raise ValueError("invalid SMART status")
        for key in ("temperature_c", "power_on_hours"):
            if smart[key] is not None and (type(smart[key]) is not int or smart[key] < 0):
                raise ValueError("invalid SMART status")
        safe_disks.append({"model": bounded_string(item["model"], 160), "size_bytes": item["size_bytes"], "transport": bounded_string(item["transport"], 32), "smart": {"available": smart["available"], "temperature_c": smart["temperature_c"], "power_on_hours": smart["power_on_hours"], "health": smart["health"]}})
    software = value["software_raid"]
    if not isinstance(software, dict) or set(software) != {"md_arrays", "zfs"} or not isinstance(software["md_arrays"], list) or len(software["md_arrays"]) > 128 or not isinstance(software["zfs"], dict) or set(software["zfs"]) != {"available", "pools"} or type(software["zfs"]["available"]) is not bool or not isinstance(software["zfs"]["pools"], list) or len(software["zfs"]["pools"]) > 128:
        raise ValueError("invalid software RAID status")
    md_arrays = []
    for item in software["md_arrays"]:
        if not isinstance(item, dict) or not {"name", "level", "state", "expected_members", "active_members", "health", "sync"}.issubset(item) or item["health"] not in {"healthy", "degraded", "unknown"} or type(item["expected_members"]) is not int or type(item["active_members"]) is not int or not 0 <= item["active_members"] <= item["expected_members"]:
            raise ValueError("invalid Linux RAID status")
        sync = item["sync"]
        if not isinstance(sync, dict) or set(sync) != {"action", "percent"} or sync["action"] not in {None, "recovery", "resync", "reshape", "check"} or type(sync["percent"]) not in {int, float} or not 0 <= sync["percent"] <= 100:
            raise ValueError("invalid Linux RAID progress")
        md_arrays.append({key: item[key] for key in ("name", "level", "state", "expected_members", "active_members", "health", "sync")})
        for key in ("name", "level", "state"):
            bounded_string(md_arrays[-1][key], 64)
    zfs_pools = []
    for item in software["zfs"]["pools"]:
        if not isinstance(item, dict) or set(item) != {"name", "size_bytes", "allocated_bytes", "free_bytes", "health", "status"} or item["status"] not in {"healthy", "degraded", "failing", "unknown"} or any(type(item[key]) is not int or item[key] < 0 for key in ("size_bytes", "allocated_bytes", "free_bytes")):
            raise ValueError("invalid ZFS status")
        zfs_pools.append(item)
        bounded_string(item["name"], 64); bounded_string(item["health"], 32)
    hardware = value["hardware_raid"]
    if not isinstance(hardware, dict) or not {"controllers", "vendor_reports"}.issubset(hardware) or not isinstance(hardware["controllers"], list) or len(hardware["controllers"]) > 64 or not isinstance(hardware["vendor_reports"], list) or len(hardware["vendor_reports"]) > 64:
        raise ValueError("invalid hardware RAID status")
    for report in hardware["vendor_reports"]:
        if not isinstance(report, dict) or type(report.get("healthy")) is not bool or not all(isinstance(report.get(key), list) and len(report[key]) <= 256 for key in ("physical_drives", "logical_volumes", "cache_protection")):
            raise ValueError("invalid hardware RAID report")
    return {"schema": 1, "generated_unix": value["generated_unix"], "overall": value["overall"], "disks": safe_disks, "software_raid": {"md_arrays": md_arrays, "zfs": {"available": software["zfs"]["available"], "pools": zfs_pools}}, "hardware_raid": {"controller_count": len(hardware["controllers"]), "full_visibility_count": len(hardware["vendor_reports"]), "attention_count": sum(report["healthy"] is False for report in hardware["vendor_reports"])}}

def settings_feed() -> dict:
    try:
        value = regular_json(UPDATE_POLICY, 65536)
    except FileNotFoundError:
        value = regular_json(DEFAULT_UPDATE_POLICY, 65536)
    expected = {"schema", "automatic_checks", "setup_choice_recorded", "channel"}
    if not isinstance(value, dict) or set(value) != expected or value["schema"] != 2 or type(value["automatic_checks"]) is not bool or type(value["setup_choice_recorded"]) is not bool or value["channel"] not in {"stable", "beta"}:
        raise ValueError("invalid update policy")
    return {"schema": 1, "updates": {"automatic_checks": value["automatic_checks"], "setup_choice_recorded": value["setup_choice_recorded"], "channel": value["channel"], "automatic_install": False}, "telemetry_enabled": False}

def dashboard() -> dict:
    result = {"schema": 1, "components": {}}
    components = result["components"]
    readers = {
        "hardware": lambda value: {
            "architecture": value["cpu"]["architecture"],
            "logical_processors": value["cpu"]["logical_processors"],
            "virtualization_supported": value["cpu"]["virtualization_supported"],
            "memory_total_bytes": value["memory"]["total_bytes"],
            "disk_count": len(value["disks"]), "network_count": len(value["networks"]),
        },
        "storage": lambda value: {
            "generated_unix": value["generated_unix"], "overall": value["overall"],
            "disk_count": len(value["disks"]), "read_only": value["read_only"],
        },
        "alerts": lambda value: {
            "generated_unix": value["generated_unix"], "attention_required": value["attention_required"],
            "active_count": value["active_count"],
        },
        "vms": lambda value: {
            "generated_unix": value["generated_unix"], "total": len(value["domains"]),
            "running": sum(item["state"] == "running" for item in value["domains"]),
        },
        "updates": lambda value: {
            key: value[key] for key in ("status", "checked_unix", "installed_generation", "available_generation", "available_version", "available_channel")
        },
    }
    for name, path in (("hardware", HARDWARE), ("storage", STORAGE), ("alerts", ALERTS), ("vms", VMS), ("updates", UPDATES)):
        try:
            value = regular_json(path, 1048576)
            if not isinstance(value, dict) or value.get("schema") not in (1, 2):
                raise ValueError("invalid state schema")
            components[name] = {"status": "available", "data": readers[name](value)}
        except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
            components[name] = {"status": "unavailable"}
    result["partial"] = any(value["status"] != "available" for value in components.values())
    return result

class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    server_version = "BedrockAPI/1"
    sys_version = ""

    def send_json(self, status: int, value: object) -> None:
        body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8") + b"\n"
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        if not authorized(self.headers.get("Authorization")):
            self.send_json(401, {"schema": 1, "error": "unauthorized"})
            return
        if self.path == "/api/v1/health":
            self.send_json(200, {"schema": 1, "status": "ok", "api_version": "v1"})
        elif self.path == "/api/v1/openapi.json":
            try:
                self.send_json(200, regular_json(OPENAPI, 262144))
            except (OSError, ValueError, json.JSONDecodeError):
                self.send_json(503, {"schema": 1, "error": "schema-unavailable"})
        elif self.path == "/api/v1/virtualization/capabilities":
            try:
                data = regular_json(CAPABILITIES, 65536)
