def regular_json(path: pathlib.Path, limit: int) -> object:
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    descriptor = os.open(path, flags)
    try:
        before = os.fstat(descriptor)
        if not stat.S_ISREG(before.st_mode) or before.st_size > limit:
            raise ValueError("unsafe state file")
        chunks = []
        remaining = limit + 1
        while remaining:
            chunk = os.read(descriptor, min(65536, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        after = os.fstat(descriptor)
        if remaining == 0 or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("state changed while being read")
        return json.loads(b"".join(chunks).decode("utf-8"))
    finally:
        os.close(descriptor)

def authorized(value: str | None) -> bool:
    if not value or not value.startswith("Bearer "):
        return False
    token = value[7:]
    if len(token) != 64 or any(c not in "0123456789abcdef" for c in token):
        return False
    digest = hashlib.sha256(token.encode("ascii")).hexdigest()
    try:
        state = regular_json(TOKENS, 65536)
        if set(state) != {"schema", "tokens"} or state["schema"] != 1 or not isinstance(state["tokens"], list):
            return False
        return any(isinstance(item, dict) and set(item) == {"name", "sha256", "created_at", "revoked"} and item["revoked"] is False and hmac.compare_digest(item["sha256"], digest) for item in state["tokens"])
    except (OSError, ValueError, json.JSONDecodeError, TypeError):
        return False

def broker_action(request_id: str, broker_request: dict) -> dict:
    if not DEVICE_ID.fullmatch(request_id):
        raise ValueError("invalid idempotency key")
    raw = json.dumps(broker_request, sort_keys=True, separators=(",", ":")).encode("utf-8")
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(5)
    try:
        client.connect(str(ACTION_BROKER))
        client.sendall(raw)
        client.shutdown(socket.SHUT_WR)
        chunks, length = [], 0
        while True:
            chunk = client.recv(min(4096, 4097 - length))
            if not chunk:
                break
            chunks.append(chunk)
            length += len(chunk)
            if length > 4096:
                raise OSError("oversized broker response")
    finally:
        client.close()
    try:
        result = json.loads(b"".join(chunks).decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise OSError("invalid broker response") from error
    if not isinstance(result, dict) or result.get("schema") != 1 or result.get("request_id") != request_id:
        raise OSError("invalid broker response")
    if result.get("status") == "succeeded" and set(result) == {"schema", "request_id", "status", "replayed"} and type(result["replayed"]) is bool:
        return result
    error = result.get("error")
    if result.get("status") in {"rejected", "failed"} and isinstance(error, dict) and set(error) == {"code", "message"} and error.get("code") in {
        "idempotency-conflict", "action-failed", "internal-error"
    }:
        return result
    raise OSError("invalid broker response")

def update_policy_action(request_id: str, body: object) -> dict:
    if not isinstance(body, dict) or set(body) != {"schema", "setting", "value", "beta_risk_acknowledged"} or body["schema"] != 1:
        raise ValueError("invalid update-policy request")
    setting, value, acknowledged = body["setting"], body["value"], body["beta_risk_acknowledged"]
    if type(acknowledged) is not bool or not (
        (setting == "automatic_checks" and type(value) is bool and not acknowledged) or
        (setting == "channel" and value == "stable" and not acknowledged) or
        (setting == "channel" and value == "beta" and acknowledged)
    ):
        raise ValueError("invalid update-policy request")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "update-policy",
                         "setting": setting, "value": value, "beta_risk_acknowledged": acknowledged})

def vm_control_action(request_id: str, name: str, body: object) -> dict:
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or not isinstance(body, dict) or set(body) != {"schema", "operation", "confirmation"} or body.get("schema") != 1:
        raise ValueError("invalid VM control request")
    operation, confirmation = body["operation"], body["confirmation"]
    if operation not in {"start", "stop", "restart", "force-stop"} or not isinstance(confirmation, str):
        raise ValueError("invalid VM control request")
    expected = {"start": "START VM ", "stop": "STOP VM ", "restart": "RESTART VM ", "force-stop": "FORCE STOP VM "}[operation] + name
    if not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid VM confirmation")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-control",
                         "name": name, "operation": operation, "confirmation": confirmation})

def vm_snapshot_action(request_id: str, name: str, body: object) -> dict:
    pattern = r"[a-z][a-z0-9-]{0,30}[a-z0-9]"
    if not re.fullmatch(pattern, name) or not isinstance(body, dict) or set(body) != {"schema", "snapshot", "operation", "confirmation"} or body.get("schema") != 1:
        raise ValueError("invalid VM snapshot request")
    snapshot, operation, confirmation = body["snapshot"], body["operation"], body["confirmation"]
    if not isinstance(snapshot, str) or not re.fullmatch(pattern, snapshot) or operation not in {"create", "restore", "delete"} or not isinstance(confirmation, str):
        raise ValueError("invalid VM snapshot request")
    expected = {"create": "CREATE SNAPSHOT ", "restore": "RESTORE SNAPSHOT ", "delete": "DELETE SNAPSHOT "}[operation] + snapshot + " FOR VM " + name
    if not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid snapshot confirmation")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-snapshot",
                         "name": name, "snapshot": snapshot, "operation": operation, "confirmation": confirmation})

def vm_clone_action(request_id: str, source: str, body: object) -> dict:
    pattern = r"[a-z][a-z0-9-]{0,30}[a-z0-9]"
    if not re.fullmatch(pattern, source) or not isinstance(body, dict) or set(body) != {"schema", "name", "confirmation"} or body.get("schema") != 1:
        raise ValueError("invalid VM clone request")
    name, confirmation = body["name"], body["confirmation"]
    if not isinstance(name, str) or not re.fullmatch(pattern, name) or name == source or not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, f"CLONE VM {source} AS {name}"):
        raise ValueError("invalid VM clone request")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-clone",
                         "source": source, "name": name, "confirmation": confirmation})

def vm_delete_action(request_id: str, name: str, body: object) -> dict:
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or not isinstance(body, dict) or set(body) != {"schema", "confirmation"} or body.get("schema") != 1:
        raise ValueError("invalid VM delete request")
    confirmation = body["confirmation"]
    if not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, f"DELETE VM {name} AND STORAGE"):
        raise ValueError("invalid VM delete confirmation")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-delete",
                         "name": name, "confirmation": confirmation})

def vm_resource_action(request_id: str, name: str, body: object) -> dict:
    fields = {"schema", "vcpus", "memory_mib", "boot_order", "confirmation"}
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or not isinstance(body, dict) or set(body) != fields or body.get("schema") != 1:
        raise ValueError("invalid VM resource request")
    vcpus, memory, boot, confirmation = body["vcpus"], body["memory_mib"], body["boot_order"], body["confirmation"]
    if type(vcpus) is not int or not 1 <= vcpus <= 64 or type(memory) is not int or not 512 <= memory <= 262144 or memory % 256 or boot not in (["disk"], ["cdrom", "disk"]):
        raise ValueError("invalid VM resources")
    expected = f"UPDATE VM {name} CPU {vcpus} MEMORY {memory} BOOT {','.join(boot)}"
    if not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid VM resource confirmation")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-resources",
                         "name": name, "vcpus": vcpus, "memory_mib": memory, "boot_order": boot, "confirmation": confirmation})

def vm_create_action(request_id: str, body: object) -> dict:
    fields = {"schema", "name", "vcpus", "memory_mib", "disk_size_gib", "autostart", "confirmation"}
    if not isinstance(body, dict) or set(body) != fields or body.get("schema") != 1:
        raise ValueError("invalid VM creation request")
    name, vcpus, memory, disk, autostart, confirmation = body["name"], body["vcpus"], body["memory_mib"], body["disk_size_gib"], body["autostart"], body["confirmation"]
    if not isinstance(name, str) or not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or type(vcpus) is not int or not 1 <= vcpus <= 64 or type(memory) is not int or not 512 <= memory <= 262144 or memory % 256 or type(disk) is not int or not 8 <= disk <= 4096 or type(autostart) is not bool or not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, f"CREATE VM {name}"):
        raise ValueError("invalid VM creation request")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-create", "name": name,
                         "vcpus": vcpus, "memory_mib": memory, "disk_size_gib": disk, "autostart": autostart, "confirmation": confirmation})

def vm_attachment_action(request_id: str, name: str, body: object, kind: str) -> dict:
    pattern = r"[a-z][a-z0-9-]{0,30}[a-z0-9]"
    fields = {"schema", kind, "operation", "confirmation"}
    if not re.fullmatch(pattern, name) or not isinstance(body, dict) or set(body) != fields or body.get("schema") != 1:
        raise ValueError("invalid VM attachment request")
    item, operation, confirmation = body[kind], body["operation"], body["confirmation"]
    if not isinstance(item, str) or not re.fullmatch(pattern, item) or operation not in {"attach", "detach"}:
        raise ValueError("invalid VM attachment request")
    label = kind.upper()
    expected = f"ATTACH {label} {item} TO VM {name}" if operation == "attach" else f"DETACH {label} {item} FROM VM {name}"
    if not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid VM attachment confirmation")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": f"vm-{kind}-attachment",
                         "name": name, kind: item, "operation": operation, "confirmation": confirmation})

def vm_passthrough_action(request_id: str, name: str, body: object) -> dict:
    fields = {"schema", "kind", "devices", "operation", "review_confirmation", "confirmation"}
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,30}[a-z0-9]", name) or not isinstance(body, dict) or set(body) != fields or body.get("schema") != 1:
        raise ValueError("invalid VM passthrough request")
    kind, devices, operation = body["kind"], body["devices"], body["operation"]
    if kind not in {"gpu", "usb"} or operation not in {"assign", "remove"} or not isinstance(devices, list) or not 1 <= len(devices) <= 16 or not all(isinstance(item, str) and 1 <= len(item) <= 64 for item in devices) or len(devices) != len(set(devices)):
        raise ValueError("invalid VM passthrough request")
    ordered = sorted(devices)
    label = kind.upper()
    review = f"REVIEW {label} PASSTHROUGH VM {name} DEVICES {','.join(ordered)}"
    confirmation = f"{operation.upper()} {label} PASSTHROUGH VM {name} DEVICES {','.join(ordered)}"
    if not isinstance(body["review_confirmation"], str) or not hmac.compare_digest(body["review_confirmation"], review) or not isinstance(body["confirmation"], str) or not hmac.compare_digest(body["confirmation"], confirmation):
        raise ValueError("invalid VM passthrough confirmations")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "vm-passthrough", "name": name,
                         "kind": kind, "devices": ordered, "operation": operation,
                         "review_confirmation": review, "confirmation": confirmation})

def remote_device_action(request_id: str, device_id: str, body: object) -> dict:
    if not DEVICE_ID.fullmatch(device_id) or not isinstance(body, dict) or body.get("schema") != 1:
        raise ValueError("invalid remote device request")
    operation = body.get("operation")
    request = {"schema": 1, "request_id": request_id, "action": "remote-device", "operation": operation, "id": device_id}
    if operation == "rename" and set(body) == {"schema", "operation", "name"} and isinstance(body["name"], str) and 1 <= len(body["name"]) <= 64 and not any(ord(char) < 32 for char in body["name"]):
        request["name"] = body["name"]
    elif operation == "expire" and set(body) == {"schema", "operation", "expires_unix", "confirmation"} and type(body["expires_unix"]) is int and isinstance(body["confirmation"], str) and hmac.compare_digest(body["confirmation"], f"EXPIRE REMOTE DEVICE {device_id} AT {body['expires_unix']}"):
        request.update(expires_unix=body["expires_unix"], confirmation=body["confirmation"])
    elif operation == "revoke" and set(body) == {"schema", "operation", "confirmation"} and isinstance(body["confirmation"], str) and hmac.compare_digest(body["confirmation"], f"REVOKE REMOTE DEVICE {device_id}"):
        request["confirmation"] = body["confirmation"]
    else:
        raise ValueError("invalid remote device change or confirmation")
    return broker_action(request_id, request)

def image_conversion_action(request_id: str, source: str, body: object) -> dict:
    fields = {"schema", "target", "target_type", "source_sha256", "confirmation"}
    if not VM_NAME.fullmatch(source) or not isinstance(body, dict) or set(body) != fields or body.get("schema") != 1:
        raise ValueError("invalid image conversion")
    target, target_type, source_hash, confirmation = body["target"], body["target_type"], body["source_sha256"], body["confirmation"]
    expected = f"CONVERT IMAGE {source} {source_hash} TO {target_type.upper()} {target}" if target_type in {"qcow2", "img"} else ""
    if not isinstance(target, str) or not VM_NAME.fullmatch(target) or target == source or not isinstance(source_hash, str) or not SHA256.fullmatch(source_hash) or not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid image conversion")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "image-convert", "source": source,
                         "source_sha256": source_hash, "target": target, "target_type": target_type, "confirmation": confirmation})

