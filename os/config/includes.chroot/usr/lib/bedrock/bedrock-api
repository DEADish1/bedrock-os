def user_feed() -> dict:
    value = regular_json(NAS, 1048576)
    expected = {"schema", "users", "groups", "datasets", "shares", "snapshots"}
    if not isinstance(value, dict) or set(value) != expected or value["schema"] != 1 or any(not isinstance(value[key], list) for key in expected - {"schema"}) or len(value["users"]) > 256 or len(value["groups"]) > 256:
        raise ValueError("invalid account state")
    users = []
    names = set()
    for item in value["users"]:
        required = {"name", "credential_generation", "created_unix"}
        if not isinstance(item, dict) or set(item) not in (required, required | {"credential_rotated_unix"}) or not NAS_ID.fullmatch(item["name"] if isinstance(item.get("name"), str) else "") or type(item["credential_generation"]) is not int or not 0 <= item["credential_generation"] <= 1000000 or type(item["created_unix"]) is not int or item["created_unix"] < 0:
            raise ValueError("invalid account")
        rotated = item.get("credential_rotated_unix")
        if rotated is not None and (type(rotated) is not int or rotated < item["created_unix"]):
            raise ValueError("invalid credential timestamp")
        if item["name"] in names:
            raise ValueError("duplicate account")
        names.add(item["name"])
        users.append({"name": item["name"], "credential_generation": item["credential_generation"], "created_unix": item["created_unix"], "credential_rotated_unix": rotated})
    groups = []
    group_names = set()
    for item in value["groups"]:
        if not isinstance(item, dict) or set(item) != {"name", "members", "created_unix"} or not NAS_ID.fullmatch(item["name"] if isinstance(item.get("name"), str) else "") or not isinstance(item["members"], list) or len(item["members"]) > 256 or len(item["members"]) != len(set(item["members"])) or any(not isinstance(member, str) or member not in names for member in item["members"]) or type(item["created_unix"]) is not int or item["created_unix"] < 0:
            raise ValueError("invalid group")
        if item["name"] in names or item["name"] in group_names:
            raise ValueError("duplicate group")
        group_names.add(item["name"])
        groups.append({"name": item["name"], "member_count": len(item["members"]), "created_unix": item["created_unix"]})
    return {"schema": 1, "users": users, "groups": groups}

