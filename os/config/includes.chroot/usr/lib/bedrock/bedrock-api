def app_control_action(request_id: str, app_id: str, body: object, forced_operation: str | None = None) -> dict:
    expected_fields = {"schema", "confirmation"} if forced_operation else {"schema", "operation", "confirmation"}
    if not re.fullmatch(r"[a-z][a-z0-9-]{0,31}", app_id) or not isinstance(body, dict) or set(body) != expected_fields or body.get("schema") != 1:
        raise ValueError("invalid application control")
    operation, confirmation = forced_operation or body["operation"], body["confirmation"]
    allowed = {forced_operation} if forced_operation else {"start", "stop"}
    expected = f"UPDATE APPLICATION {app_id}" if operation == "update-latest" and operation in allowed else f"INSTALL APPLICATION {app_id}" if operation == "install-staged" and operation in allowed else f"{operation.upper()} APPLICATION {app_id}" if operation in allowed else ""
    if not isinstance(confirmation, str) or not hmac.compare_digest(confirmation, expected):
        raise ValueError("invalid application control")
    return broker_action(request_id, {"schema": 1, "request_id": request_id, "action": "app-control", "id": app_id,
                         "operation": operation, "confirmation": confirmation})

