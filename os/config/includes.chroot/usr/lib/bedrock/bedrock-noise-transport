#!/usr/bin/python3
"""One bounded Bedrock control exchange over a Noise XX connected stream."""

import base64
import binascii
import http.client
import json
import os
import pathlib
import re
import socket
import struct
import sys
import time

from cryptography.hazmat.primitives import serialization
from noise.connection import Keypair, NoiseConnection
from noise.exceptions import NoiseHandshakeError, NoiseInvalidMessage, NoiseValidationError, NoiseValueError

PROTOCOL = b"Noise_XX_25519_ChaChaPoly_SHA256"
PROLOGUE = b"bedrock-remote-control-v1|initiator=client|responder=server"
PRIVATE_KEY = pathlib.Path(os.environ.get("BEDROCK_NOISE_PRIVATE_KEY", "/var/lib/bedrock/remote/server-private-key.pem"))
GATEWAY = pathlib.Path(os.environ.get("BEDROCK_NOISE_GATEWAY", "/run/bedrock-pairing/gateway.sock"))
API_SOCKET = pathlib.Path(os.environ.get("BEDROCK_NOISE_API_SOCKET", "/run/bedrock-api/api.sock"))
API_TOKEN_FILE = os.environ.get("BEDROCK_NOISE_API_TOKEN_FILE")
MAX_HANDSHAKE = 65535
MAX_PLAINTEXT = 61440
MAX_GATEWAY_RESPONSE = 4096
MAX_API_BODY = 32768
MAX_RECORDS = 1048576
MAX_DIRECTION_BYTES = 1073741824
MAX_AGE_SECONDS = 3600
REKEY_RECORDS = 65536
DEVICE_ID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$")
API_PATH = re.compile(r"^/api/v1/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]{0,1024}$")
API_HEADERS = {"content-type", "idempotency-key", "if-match", "x-bedrock-image-type"}


class ProtocolError(Exception):
    pass


def read_exact(stream, count: int) -> bytes:
    chunks = bytearray()
    while len(chunks) < count:
        chunk = stream.read(count - len(chunks))
        if not chunk:
            raise ProtocolError("truncated stream")
        chunks.extend(chunk)
    return bytes(chunks)


def read_frame(stream, maximum: int) -> bytes:
    size = struct.unpack("!I", read_exact(stream, 4))[0]
    if size == 0 or size > maximum:
        raise ProtocolError("invalid frame length")
    return read_exact(stream, size)


def write_frame(stream, value: bytes) -> None:
    stream.write(struct.pack("!I", len(value)) + value)
    stream.flush()


def load_private_key(path: pathlib.Path) -> bytes:
    if not path.is_file() or path.is_symlink():
        raise ProtocolError("private identity is unavailable")
    key = serialization.load_pem_private_key(path.read_bytes(), password=None)
    return key.private_bytes(serialization.Encoding.Raw, serialization.PrivateFormat.Raw,
                             serialization.NoEncryption())


def unpack_record(plain: bytes, expected_sequence: int) -> dict:
    if len(plain) < 13:
        raise ProtocolError("short record")
    version, sequence, size = struct.unpack("!BQI", plain[:13])
    body = plain[13:]
    if version != 1 or sequence != expected_sequence or size != len(body) or size > MAX_PLAINTEXT - 13:
        raise ProtocolError("invalid authenticated record")
    try:
        value = json.loads(body.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise ProtocolError("invalid control message") from error
    if not isinstance(value, dict) or value.get("schema") != 1:
        raise ProtocolError("unsupported control message")
    return value


def pack_record(value: dict, sequence: int) -> bytes:
    body = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("utf-8")
    if len(body) > MAX_PLAINTEXT - 13:
        raise ProtocolError("response is too large")
    return struct.pack("!BQI", 1, sequence, len(body)) + body


def gateway_exchange(value: dict) -> dict:
    raw = json.dumps(value, sort_keys=True, separators=(",", ":")).encode("ascii")
    if len(raw) > 1024:
        raise ProtocolError("gateway request is too large")
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(str(GATEWAY))
        client.sendall(raw)
        client.shutdown(socket.SHUT_WR)
        result = bytearray()
        while len(result) <= MAX_GATEWAY_RESPONSE:
            chunk = client.recv(min(1024, MAX_GATEWAY_RESPONSE + 1 - len(result)))
            if not chunk:
                break
            result.extend(chunk)
    if len(result) > MAX_GATEWAY_RESPONSE:
        raise ProtocolError("gateway response is too large")
    response = json.loads(bytes(result).decode("utf-8"))
    if not isinstance(response, dict) or response.get("schema") != 1:
        raise ProtocolError("invalid gateway response")
    return response


def load_api_token() -> str:
    if not API_TOKEN_FILE:
        raise ProtocolError("API credential is unavailable")
    path = pathlib.Path(API_TOKEN_FILE)
    if not path.is_file() or path.is_symlink():
        raise ProtocolError("API credential is unavailable")
    token = path.read_text(encoding="ascii").strip()
    if not re.fullmatch(r"[0-9a-f]{64}", token):
        raise ProtocolError("API credential is invalid")
    return token


def api_exchange(value: dict, token: str) -> dict:
    if set(value) != {"schema", "action", "method", "path", "headers", "body"} or value.get("schema") != 1 or value.get("action") != "api":
        raise ProtocolError("invalid API request")
    method, path, headers, encoded_body = value["method"], value["path"], value["headers"], value["body"]
    if method not in {"GET", "POST", "PUT", "DELETE"} or not isinstance(path, str) or not API_PATH.fullmatch(path):
        raise ProtocolError("invalid API route")
    if not isinstance(headers, dict) or len(headers) > 4 or any(not isinstance(key, str) or key.lower() not in API_HEADERS or not isinstance(item, str) or len(item) > 256 or "\r" in item or "\n" in item for key, item in headers.items()):
        raise ProtocolError("invalid API headers")
    if len({key.lower() for key in headers}) != len(headers) or not isinstance(encoded_body, str):
        raise ProtocolError("invalid API request")
    try:
        body = base64.b64decode(encoded_body, validate=True)
    except (ValueError, binascii.Error) as error:
        raise ProtocolError("invalid API body") from error
    if len(body) > MAX_API_BODY or (method == "GET" and body):
        raise ProtocolError("invalid API body")

    lines = [f"{method} {path} HTTP/1.1", "Host: bedrock.local", f"Authorization: Bearer {token}",
             "Connection: close", f"Content-Length: {len(body)}"]
    lines.extend(f"{key}: {item}" for key, item in headers.items())
    raw = ("\r\n".join(lines) + "\r\n\r\n").encode("ascii") + body
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(10)
        client.connect(str(API_SOCKET))
        client.sendall(raw)
        response = http.client.HTTPResponse(client)
        response.begin()
        response_body = response.read(MAX_API_BODY + 1)
        if len(response_body) > MAX_API_BODY or response.read(1):
            raise ProtocolError("API response is too large")
        content_type = response.getheader("Content-Type", "")
        etag = response.getheader("ETag")
        if content_type and len(content_type) > 128 or etag is not None and (len(etag) > 128 or "\r" in etag or "\n" in etag):
            raise ProtocolError("invalid API response headers")
        return {"schema": 1, "status": response.status, "content_type": content_type,
                "etag": etag, "body": base64.b64encode(response_body).decode("ascii")}


def serve(input_stream, output_stream, required_device: str | None = None) -> None:
    noise = NoiseConnection.from_name(PROTOCOL)
    noise.set_as_responder()
    noise.set_prologue(PROLOGUE)
    noise.set_keypair_from_private_bytes(Keypair.STATIC, load_private_key(PRIVATE_KEY))
    noise.start_handshake()
    noise.read_message(read_frame(input_stream, MAX_HANDSHAKE))
    write_frame(output_stream, bytes(noise.write_message()))
    noise.read_message(read_frame(input_stream, MAX_HANDSHAKE))
    if not noise.handshake_finished:
        raise ProtocolError("incomplete handshake")
    remote = noise.noise_protocol.handshake_state.rs
    if remote is None or len(remote.public_bytes) != 32:
        raise ProtocolError("missing client identity")

    encrypted = read_frame(input_stream, MAX_PLAINTEXT + 16)
    request = unpack_record(bytes(noise.decrypt(encrypted)), 0)
    if request.get("action") not in {"request", "redeem", "authorize"}:
        raise ProtocolError("unsupported action")
    if required_device is not None and (request.get("action") != "authorize" or request.get("device_id") != required_device):
        raise ProtocolError("session route does not match authenticated request")
    supplied = request.get("client_public_key")
    proven_key = remote.public_bytes.hex()
    if supplied is not None and supplied != proven_key:
        raise ProtocolError("client identity mismatch")
    request["client_public_key"] = proven_key
    response = gateway_exchange(request)
    write_frame(output_stream, bytes(noise.encrypt(pack_record(response, 0))))
    if required_device is None or response.get("status") != "authorized" or response.get("device_id") != required_device:
        return

    token = load_api_token()
    started = time.monotonic()
    inbound_bytes = outbound_bytes = 0
    sequence = 1
    while sequence < MAX_RECORDS and time.monotonic() - started <= MAX_AGE_SECONDS:
        try:
            encrypted = read_frame(input_stream, MAX_PLAINTEXT + 16)
        except ProtocolError as error:
            if str(error) == "truncated stream":
                return
            raise
        inbound_bytes += len(encrypted)
        if inbound_bytes > MAX_DIRECTION_BYTES:
            raise ProtocolError("inbound byte limit exceeded")
        api_request = unpack_record(bytes(noise.decrypt(encrypted)), sequence)
        api_response = api_exchange(api_request, token)
        encrypted_response = bytes(noise.encrypt(pack_record(api_response, sequence)))
        outbound_bytes += len(encrypted_response)
        if outbound_bytes > MAX_DIRECTION_BYTES:
            raise ProtocolError("outbound byte limit exceeded")
        write_frame(output_stream, encrypted_response)
        sequence += 1
        if sequence % REKEY_RECORDS == 0:
            noise.rekey_inbound_cipher()
            noise.rekey_outbound_cipher()


def main() -> None:
    required_device = None
    if len(sys.argv) == 3 and sys.argv[1] == "--require-device" and DEVICE_ID.fullmatch(sys.argv[2]):
        required_device = sys.argv[2]
    elif len(sys.argv) != 1:
        raise SystemExit(2)
    try:
        serve(sys.stdin.buffer, sys.stdout.buffer, required_device)
    except (BrokenPipeError, OSError, ProtocolError, NoiseHandshakeError, NoiseInvalidMessage,
            NoiseValidationError, NoiseValueError, ValueError, json.JSONDecodeError):
        # The connected peer gets only a closed stream; details must not become a remote oracle.
        raise SystemExit(1)


if __name__ == "__main__":
    main()
