#!/usr/bin/python3
import json,os,pathlib,subprocess,sys,tempfile,time
EVENTS={"ONLINE":"online","ONBATT":"on-battery","LOWBATT":"low-battery","FSD":"forced-shutdown"}
def fail(message): raise SystemExit(f"error: {message}")
def atomic(path,value):
    path.parent.mkdir(parents=True,exist_ok=True); handle,temp=tempfile.mkstemp(prefix=".ups.",dir=path.parent)
    try:
        with os.fdopen(handle,"w") as out: json.dump(value,out,sort_keys=True,separators=(",",":")); out.write("\n"); out.flush(); os.fsync(out.fileno())
        os.chmod(temp,0o600); os.replace(temp,path)
    finally:
        if os.path.exists(temp): os.unlink(temp)
def main():
    if len(sys.argv)!=2 or sys.argv[1] not in EVENTS: fail("unsupported UPS event")
    test=os.environ.get("BEDROCK_UPS_TEST_MODE")=="1"
    if not test and os.geteuid()!=0: fail("UPS event handling requires root")
    state=pathlib.Path(os.environ.get("BEDROCK_UPS_STATE","/var/lib/bedrock/ups/status.json")) if test else pathlib.Path("/var/lib/bedrock/ups/status.json"); maintenance=os.environ.get("BEDROCK_UPS_MAINTENANCE","bedrock-maintenance") if test else "/usr/sbin/bedrock-maintenance"; systemctl=os.environ.get("BEDROCK_UPS_SYSTEMCTL","systemctl") if test else "/bin/systemctl"; now=int(os.environ.get("BEDROCK_UPS_TEST_NOW",str(int(time.time())))); event=sys.argv[1]
    result={"schema":1,"status":EVENTS[event],"occurred_unix":now,"maintenance_quiesced":None,"shutdown_requested":False}
    if event in {"LOWBATT","FSD"}:
        command=([sys.executable,maintenance] if test else [maintenance])+["enter","ENTER BEDROCK MAINTENANCE"]
        completed=subprocess.run(command,env=os.environ.copy(),stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL); result["maintenance_quiesced"]=completed.returncode==0; result["shutdown_requested"]=True; atomic(state,result); subprocess.run(([sys.executable,systemctl] if test and systemctl.endswith(".py") else [systemctl])+["poweroff","--no-block"],check=True)
    else: atomic(state,result)
    print(json.dumps(result,sort_keys=True,separators=(",",":")))
if __name__=="__main__": main()
