#!/bin/sh
set -eu

[ "$#" -eq 2 ] || { printf 'usage: %s BUNDLE_DIR TRUSTED_CERT\n' "$0" >&2; exit 2; }
bundle=$1
cert=$2
manifest="$bundle/manifest.json"
signature="$bundle/manifest.p7s"
[ -s "$manifest" ] && [ -s "$signature" ] && [ -s "$cert" ] || { printf 'error: update manifest, signature, or trust certificate is missing\n' >&2; exit 1; }
for tool in jq openssl sha256sum stat; do command -v "$tool" >/dev/null 2>&1 || { printf 'error: %s is required\n' "$tool" >&2; exit 1; }; done

openssl cms -verify -binary -inform DER -in "$signature" -content "$manifest" \
  -CAfile "$cert" -purpose any -out /dev/null >/dev/null 2>&1 || { printf 'error: update manifest signature is invalid\n' >&2; exit 1; }
jq -e '
  .schema == 1 and .product == "Bedrock Server OS" and .architecture == "amd64" and
  (.version | type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+([+-][A-Za-z0-9.-]+)?$")) and
  (.generation | type == "number" and . > 0 and floor == .) and
  ([.artifacts[].name] == ["root.erofs","root.verity","verity-sig.json","uki.efi"]) and
  (.artifacts | length == 4) and
  all(.artifacts[]; (.sha256 | test("^[0-9a-f]{64}$")) and (.size | type == "number" and . > 0 and floor == .))
' "$manifest" >/dev/null || { printf 'error: update manifest schema is invalid\n' >&2; exit 1; }

jq -c '.artifacts[]' "$manifest" | while IFS= read -r item; do
  name=$(printf '%s' "$item" | jq -r .name)
  expected_hash=$(printf '%s' "$item" | jq -r .sha256)
  expected_size=$(printf '%s' "$item" | jq -r .size)
  file="$bundle/$name"
  [ -f "$file" ] || { printf 'error: update artifact %s is missing\n' "$name" >&2; exit 1; }
  actual_size=$(stat -c %s "$file" 2>/dev/null || stat -f %z "$file")
  [ "$actual_size" = "$expected_size" ] || { printf 'error: update artifact %s has the wrong size\n' "$name" >&2; exit 1; }
  actual_hash=$(sha256sum "$file" | awk '{print $1}')
  [ "$actual_hash" = "$expected_hash" ] || { printf 'error: update artifact %s failed checksum verification\n' "$name" >&2; exit 1; }
done
printf 'Verified signed Bedrock update generation %s.\n' "$(jq -r .generation "$manifest")"
