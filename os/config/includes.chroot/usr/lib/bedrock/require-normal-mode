#!/usr/bin/python3
import json,os,pathlib,stat,sys
path=pathlib.Path(os.environ["BEDROCK_MAINTENANCE_GUARD_STATE"]) if os.environ.get("BEDROCK_MAINTENANCE_GUARD_TEST_MODE")=="1" else pathlib.Path("/run/bedrock-maintenance/state.json")
if not path.exists(): raise SystemExit(0)
try:
    info=path.lstat(); value=json.loads(path.read_text())
    if not stat.S_ISREG(info.st_mode) or info.st_size>65536 or not isinstance(value,dict) or set(value)!={"schema","mode","entered_unix","units","vms"} or value.get("schema")!=1 or value.get("mode") not in {"inactive","entering","active","failed"}: raise ValueError
except (OSError,ValueError,json.JSONDecodeError):
    print("error: maintenance state is unsafe; mutations are blocked",file=sys.stderr); raise SystemExit(1)
if value.get("mode") in {"entering","active","failed"}:
    print("error: Bedrock maintenance mode blocks this operation",file=sys.stderr); raise SystemExit(1)
