[Unit]
Description=Deliver actionable Bedrock health notifications
After=network-online.target bedrock-storage-health.service
Wants=network-online.target
ConditionPathExists=/var/lib/bedrock/notifications/destinations.json

[Service]
Type=oneshot
ExecStart=/usr/sbin/bedrock-notifications dispatch
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bedrock/notifications
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
