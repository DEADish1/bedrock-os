[Unit]
Description=Publish privacy-safe Bedrock remote device status
ConditionPathExists=/var/lib/bedrock/remote/pairings.json

[Service]
Type=oneshot
ExecStart=/usr/lib/bedrock/collect-remote-status
User=root
Group=root
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bedrock/remote
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
