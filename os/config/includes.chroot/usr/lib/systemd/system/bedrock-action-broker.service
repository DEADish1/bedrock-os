[Unit]
Description=Bedrock privileged action broker
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/lib/bedrock/bedrock-action-broker
User=root
Group=bedrock-api
RuntimeDirectory=bedrock-action-broker
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bedrock/api /var/lib/bedrock/settings -/var/lib/bedrock/virtualization /run/bedrock-action-broker -/run/libvirt
CapabilityBoundingSet=
RestrictNamespaces=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
