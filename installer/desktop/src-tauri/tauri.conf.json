{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bedrock Installer",
  "version": "0.3.0",
  "identifier": "os.bedrock.installer",
  "build": { "frontendDist": "../../ui" },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [{
      "label": "main",
      "title": "Bedrock Installer",
      "width": 1180,
      "height": 780,
      "minWidth": 360,
      "minHeight": 640,
      "resizable": true,
      "fullscreen": false
    }]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "../../adapters/linux-list-targets.sh": "adapters/linux-list-targets.sh",
      "../../adapters/macos-list-targets.sh": "adapters/macos-list-targets.sh",
      "../../adapters/windows-list-targets.ps1": "adapters/windows-list-targets.ps1"
    },
    "category": "Utility",
    "shortDescription": "Safely create Bedrock OS installation media"
  }
}
